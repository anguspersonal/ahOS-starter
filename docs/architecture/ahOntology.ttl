# =====================================================================
# ahOS components, capture paths, products, outcomes, KPIs, preservation
# (Follow-ups #75, #77, #78, #79, #80, #82 — added without user input.
# Open questions flagged in the relevant class rdfs:comments above.)
# =====================================================================

# --- The three knowledge layers in ahOS (#75) ---

ahos:knowledgeRegistry a ahos:KnowledgeRegistry ;
    rdfs:label "ahOS Knowledge Registry" ;
    rdfs:comment "The single Knowledge Registry instance in ahOS. Holds routing rules and direction. OPEN QUESTION (#75): confirm boundary with artifactsRegister — modelled as distinct but needs validation against current Supabase schema." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:knowledgeGraph a ahos:KnowledgeGraph ;
    rdfs:label "ahOS Knowledge Graph" ;
    rdfs:comment "The single Knowledge Graph instance — resolved entities and relations. The substrate retrieval queries against. Realised today by the Supabase `entities` + `entity_relationships` tables." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:artifactsRegister a ahos:ArtifactsRegister ;
    rdfs:label "ahOS Artifacts Register" ;
    rdfs:comment "The single Artifacts Register — Supabase `artifacts` table. Each row a stored thing." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

# --- Capture paths (#80) ---

ahos:APIPath a ahos:CapturePath ;
    rdfs:label "API capture" ;
    rdfs:comment "Programmatic capture via cron, webhook, or integration. Authenticated; default routing per integration config. ADR-013 §4 distinction (folded from consolidated-mess section D, 2026-06-15): source_channel='agent' orchestrations chain enrichment inline (the calling agent owns the post-capture pipeline); source_channel='programmatic' defers enrichment to a later pass. Same capture primitive, different orchestration-owner contract." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:ChatInferredPath a ahos:CapturePath ;
    rdfs:label "Chat — inferred" ;
    rdfs:comment "Agent autonomously captures from conversation when it judges something worth saving. No explicit user invocation." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:ChatCalledPath a ahos:CapturePath ;
    rdfs:label "Chat — called (/capture)" ;
    rdfs:comment "User explicitly invokes /capture. Atomic per event/thought per ADR-018." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:MobileUploadPath a ahos:CapturePath ;
    rdfs:label "Mobile upload" ;
    rdfs:comment "User uploads from mobile UI. Future — not yet built per ADR-013 (web-UI pivot)." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:WebUploadPath a ahos:CapturePath ;
    rdfs:label "Web upload" ;
    rdfs:comment "User uploads from web UI. Future — not yet built per ADR-013." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

# [Outcome / KPI / Product / PreservationLevel individuals + ahOS links — moved to APPENDIX A (speculative), 2026-07-12]

# --- Status enum (#76) ---

ahos:Pending  a ahos:Status ; rdfs:label "Pending"  ; rdfs:comment "Not yet started / awaiting processing." ; ahos:level "instance" ; ahos:inBox "ABox" .
ahos:Done     a ahos:Status ; rdfs:label "Done"     ; rdfs:comment "Successfully completed." ; ahos:level "instance" ; ahos:inBox "ABox" .
ahos:Failed   a ahos:Status ; rdfs:label "Failed"   ; rdfs:comment "Attempted but failed; usually retryable." ; ahos:level "instance" ; ahos:inBox "ABox" .
ahos:Archived a ahos:Status ; rdfs:label "Archived" ; rdfs:comment "No longer active; preserved for reference. Distinct from the PARA Archive category (which is about classification) and from ahos:ColdStorage (preservation level)." ; ahos:level "instance" ; ahos:inBox "ABox" .
ahos:Open     a ahos:Status ; rdfs:label "Open"     ; rdfs:comment "Issue lifecycle — applies to Contradictions and OpenQuestions that are unresolved." ; ahos:level "instance" ; ahos:inBox "ABox" .
ahos:Resolved a ahos:Status ; rdfs:label "Resolved" ; rdfs:comment "Issue lifecycle — applies to Contradictions and OpenQuestions that have been answered or closed. Pair with ahos:resolvedBy on Contradictions to record the Decision that closed it." ; ahos:level "instance" ; ahos:inBox "ABox" .

# --- Relation-type values (#74) ---

ahos:Relation a ahos:RelationType ;
    rdfs:label "Relation" ;
    rdfs:comment "Generic association. No implied direction beyond rdf semantics; no containment. Most ahos: properties default to this." ;
    ahos:level "meta" ;
    ahos:inBox "ABox" .

ahos:Hierarchy a ahos:RelationType ;
    rdfs:label "Hierarchy" ;
    rdfs:comment "Containment / classification. Edges of this type form tree-like structures suitable for the hierarchy view. e.g. hasCategory, partOf, hasDomain, preservationLevel." ;
    ahos:level "meta" ;
    ahos:inBox "ABox" .

ahos:Flow a ahos:RelationType ;
    rdfs:label "Flow" ;
    rdfs:comment "Directional data movement. Edges of this type are filtered to in the data-flow view. e.g. produces, capturedVia." ;
    ahos:level "meta" ;
    ahos:inBox "ABox" .

# --- relationType tagging — every ObjectProperty in this file (#74) ---
#
# Categorisation rules:
#   Hierarchy  : containment / classification (forms a tree)
#   Flow       : directional data movement (drives data-flow view)
#   Relation   : generic association (everything else)
#
# Note: W3C built-ins (rdf:type, rdfs:subClassOf, rdfs:domain, rdfs:range)
# are not tagged here — they're conceptually hierarchical but live outside
# the ahos: namespace.

# Hierarchy — containment / classification
ahos:hasCategory       ahos:relationType ahos:Hierarchy .
ahos:partOf            ahos:relationType ahos:Hierarchy .
ahos:hasDomain         ahos:relationType ahos:Hierarchy .
ahos:preservationLevel ahos:relationType ahos:Hierarchy .
ahos:status            ahos:relationType ahos:Hierarchy .  # classification of state

# Flow — directional data movement
ahos:produces          ahos:relationType ahos:Flow .
ahos:capturedVia       ahos:relationType ahos:Flow .

# Relation — generic association (provenance, meta, links)
ahos:organisedBy       ahos:relationType ahos:Relation .
ahos:describes         ahos:relationType ahos:Relation .
ahos:uses              ahos:relationType ahos:Relation .
ahos:partOfAxis        ahos:relationType ahos:Relation .
ahos:hasOutcome        ahos:relationType ahos:Relation .
ahos:producesFor       ahos:relationType ahos:Relation .
ahos:measures          ahos:relationType ahos:Relation .
ahos:lastEditedBy      ahos:relationType ahos:Relation .
ahos:auditHistory      ahos:relationType ahos:Relation .
ahos:metadata          ahos:relationType ahos:Relation .
ahos:sourceLocation    ahos:relationType ahos:Relation .  # could be Flow (came from) — open
ahos:storageLocation   ahos:relationType ahos:Relation .
schema:subjectOf       ahos:relationType ahos:Relation .  # ADR-033 / #192 (adopted direct, no ahos: proxy)
dcterms:creator        ahos:relationType ahos:Relation .  # ADR-033 / #196 (adopted direct, no ahos: proxy)

# =====================================================================
# Substrate, capabilities, dotclaude-merge concepts (unrelated to #74-#82)
# Adds: MCP server + tools, Supabase DB + tables, agent skills,
# the six memory roles, code repos.
# =====================================================================

# --- Code repositories ---

ahos:ahkmsRepo a ahos:CodeRepository ;
    rdfs:label "ahkms" ;
    rdfs:comment "The substrate repo — knowledgeMgmtSystemOct2025. Contains the MCP server, Supabase migrations, and ADRs. Originally the whole product; per the brainstorm renaming, the package codename." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:dotclaudeRepo a ahos:CodeRepository ;
    rdfs:label "dotclaude" ;
    rdfs:comment "The capabilities repo — anguspersonal/dotclaude. Contains agent skills (capture, dos-eod, dos-prep, …), cowork-skills, and per-user opinions. Per ADR-019 the long-term plan is for ahkms to host owned skills via authenticated serving; until then dotclaude is the canonical home." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

# Wire up ahOS provenance
ahos:ahOS ahos:builtFrom ahos:ahkmsRepo, ahos:dotclaudeRepo .

# --- Surfaces ---

ahos:ClaudeCodeSurface a ahos:Surface ;
    rdfs:label "claude-code" ;
    rdfs:comment "Capability runs in Claude Code (the CLI/desktop). Today's primary surface for skills like /capture and /dos-eod." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:CoworkSurface a ahos:Surface ;
    rdfs:label "cowork (claude.ai)" ;
    rdfs:comment "Capability runs in claude.ai cowork. Some skills are auto-synced here by Claude — distinct from owned skills per ADR-019." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:APISurface a ahos:Surface ;
    rdfs:label "api" ;
    rdfs:comment "Capability invoked via the Anthropic API or third-party agent runtime. Less common today; reserved for completeness." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

# --- Deployment targets (where capability bytes physically deploy at runtime) ---

ahos:perRepoClaudeDir a ahos:DeploymentTarget ;
    rdfs:label ".claude/ per repo" ;
    rdfs:comment "Each consuming repo's local .claude/skills/ (or .claude/agents/, .claude/commands/) directory. Bytes flow: source repo (dotclaude today, ahkmsRepo future) → web-fetch or git pull → .claude/<kind>/ in the consuming repo → loaded by Claude Code at session start. Many physical instances (one per repo using ahOS); modelled as a single class-level target until per-repo identity becomes load-bearing." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:claudeAiCowork a ahos:DeploymentTarget ;
    rdfs:label "claude.ai cowork" ;
    rdfs:comment "Claude's claude.ai cowork web interface. Bytes flow: dotclaude/cowork-skills/ → Claude's automatic cowork sync → claude.ai workspace. Distinct from perRepoClaudeDir because the sync mechanism (Claude-controlled, automatic) and runtime (web UI) differ. Per ADR-019 §Decision item 2: cowork-synced skills are *indexed, not absorbed* — they stay on this target rather than migrating to ahkmsServingEndpoint." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:ahkmsServingEndpoint a ahos:DeploymentTarget ;
    rdfs:label "ahkms auth API (future)" ;
    rdfs:comment "The future ahkms authenticated serving endpoint per ADR-019 §Decision item 3. Bytes flow: ahkmsRepo (the new owned-skill home) → auth'd HTTP fetch/install → any environment. **NOT YET BUILT** — placeholder for the ADR-019 future state; existence is contingent on ADR-019 acceptance AND the serving API being constructed. When live, replaces the public-repo web-fetch mechanism for owned skills (cowork-synced skills stay on ahos:claudeAiCowork)." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

# --- Supabase database + tables ---

ahos:supabaseDB a ahos:Database ;
    rdfs:label "Supabase DB (ahkms)" ;
    rdfs:comment "The Postgres database backing ahkms. Contains the substrate tables (artifacts, entities, entity_relationships, artifact_external_links, capture_preferences, user_integrations, user_tasks). Hosted on Supabase Cloud." ;
    dcterms:creator ahos:angus ;
    ahos:hostedBy ahos:ahkmsRepo ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

# Wire artifactsRegister (existing) to supabaseDB
ahos:artifactsRegister ahos:partOf ahos:supabaseDB .

# Other tables
ahos:entitiesTable a ahos:Table ;
    rdfs:label "entities table" ;
    rdfs:comment "Supabase entities table — PARAMPS nouns. The structured side of the knowledge graph." ;
    ahos:partOf ahos:supabaseDB ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:entityRelationshipsTable a ahos:Table ;
    rdfs:label "entity_relationships table" ;
    rdfs:comment "Supabase entity_relationships — PARAMPS verbs (open-vocab edges between entities). Migration 049 dropped the rigid CHECK constraint." ;
    ahos:partOf ahos:supabaseDB ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:artifactExternalLinksTable a ahos:Table ;
    rdfs:label "artifact_external_links table" ;
    rdfs:comment "Cross-store lineage — (provider, kind, external_id) triples connecting artifacts to outside systems (Notion tasks, state docs, etc.). The data backbone of the 'map don't store' principle." ;
    ahos:partOf ahos:supabaseDB ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:capturePreferencesTable a ahos:Table ;
    rdfs:label "capture_preferences table" ;
    rdfs:comment "Per-user routing config — default tags, tag_rules (regex), source_channel mapping. The routing rules the registry uses at capture time." ;
    ahos:partOf ahos:supabaseDB ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:userIntegrationsTable a ahos:Table ;
    rdfs:label "user_integrations table" ;
    rdfs:comment "Per-user integration wiring — Notion DB IDs (Daily Log, State Doc, Tasks DB), per ADR-013 §6. Tokens in env; ids in the DB." ;
    ahos:partOf ahos:supabaseDB ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:userTasksTable a ahos:Table ;
    rdfs:label "user_tasks table" ;
    rdfs:comment "Vestigial per ADR-013 — tasks live in Notion (working state), not here. Kept for the schema but unused for new captures." ;
    ahos:partOf ahos:supabaseDB ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

# --- MCP server + tools ---

ahos:ahkmsMCPServer a ahos:MCPServer ;
    rdfs:label "ahkms MCP server" ;
    rdfs:comment "The Model Context Protocol server in packages/mcp-server/. Stdio-only today; per ADR-019 will gain an authenticated HTTP surface for cross-environment capability serving." ;
    ahos:hostedBy ahos:ahkmsRepo ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:captureTool a ahos:MCPTool ;
    rdfs:label "capture (MCP tool)" ;
    rdfs:comment "The dumb writer — one row into artifacts per atom, applying capture_preferences routing. Called by the /capture skill." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:searchKnowledgeTool a ahos:MCPTool ;
    rdfs:label "search_knowledge (MCP tool)" ;
    rdfs:comment "FTS over artifacts; structured filters (captured_on, not_consumed) added per PR #59. The read path for retrieval and synthesis consumers." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:getArtifactTool a ahos:MCPTool ;
    rdfs:label "get_artifact (MCP tool)" ;
    rdfs:comment "Fetch full body + lineage for a single artifact. Used by synthesisers after search narrows the candidate set." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:createExternalLinkTool a ahos:MCPTool ;
    rdfs:label "create_external_link (MCP tool)" ;
    rdfs:comment "Writes a cross-store lineage link — (provider, kind, external_id). Used by synthesisers to mark consumption (ADR-013 §7) and by integrations to link to Notion / Gmail / Drive items." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:discoverTool a ahos:MCPTool ;
    rdfs:label "discover (MCP tool)" ;
    rdfs:comment "Registry-mode pointer writer per ADR-016 — records 'this thing exists, here's where' without fetching bytes. The system-initiated inventory loop." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

# Wire MCP server to tools
ahos:ahkmsMCPServer ahos:exposes
    ahos:captureTool, ahos:searchKnowledgeTool, ahos:getArtifactTool,
    ahos:createExternalLinkTool, ahos:discoverTool .

# Tool writes/reads
ahos:captureTool             ahos:writesTo  ahos:artifactsRegister .
ahos:searchKnowledgeTool     ahos:readsFrom ahos:artifactsRegister .
ahos:getArtifactTool         ahos:readsFrom ahos:artifactsRegister .
ahos:createExternalLinkTool  ahos:writesTo  ahos:artifactExternalLinksTable .
ahos:discoverTool            ahos:writesTo  ahos:artifactsRegister .

# --- Capabilities (agent skills) ---

ahos:captureSkill a ahos:Skill ;
    rdfs:label "/capture" ;
    rdfs:comment "Atomic per event/thought; bare + inline modes. The unified capture surface per ADR-018. Shareable — per-user opinions live in capture_preferences." ;
    ahos:surface ahos:ClaudeCodeSurface ;
    ahos:hostedBy ahos:dotclaudeRepo ;
    ahos:syncedTo ahos:perRepoClaudeDir ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:dosEodSkill a ahos:Skill ;
    rdfs:label "/dos-eod" ;
    rdfs:comment "End-of-day synthesiser — per-atom inference, bundling by domain coherence, Daily Log write to Notion, mark consumed via artifact_external_links. work-scoped." ;
    ahos:surface ahos:ClaudeCodeSurface ;
    ahos:hostedBy ahos:dotclaudeRepo ;
    ahos:syncedTo ahos:perRepoClaudeDir ;
    ahos:hasDomain ahos:work ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:dosPrepSkill a ahos:Skill ;
    rdfs:label "/dos-prep" ;
    rdfs:comment "Start-of-day prep — reads State Doc + Daily Log to surface what to focus on." ;
    ahos:surface ahos:ClaudeCodeSurface ;
    ahos:hostedBy ahos:dotclaudeRepo ;
    ahos:syncedTo ahos:perRepoClaudeDir ;
    ahos:hasDomain ahos:work ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:dosBraindumpSkill a ahos:Skill ;
    rdfs:label "/dos-braindump" ;
    rdfs:comment "Unstructured-dump capture — originally dotclaude PR #4; retired and folded into /capture as --braindump per ADR-050 §3 (#487)." ;
    ahos:surface ahos:ClaudeCodeSurface ;
    ahos:hostedBy ahos:dotclaudeRepo ;
    ahos:syncedTo ahos:perRepoClaudeDir ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:dosReflectSkill a ahos:Skill ;
    rdfs:label "/dos-reflect" ;
    rdfs:comment "Weekly / periodic reflection — synthesises across a wider window than dos-eod." ;
    ahos:surface ahos:ClaudeCodeSurface ;
    ahos:hostedBy ahos:dotclaudeRepo ;
    ahos:syncedTo ahos:perRepoClaudeDir ;
    ahos:hasDomain ahos:work ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:createTaskSkill a ahos:Skill ;
    rdfs:label "/create-task" ;
    rdfs:comment "Creates a Notion task per ADR-013 — actions/tasks live in Notion (working state)." ;
    ahos:surface ahos:ClaudeCodeSurface ;
    ahos:hostedBy ahos:dotclaudeRepo ;
    ahos:syncedTo ahos:perRepoClaudeDir ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

# Wire skills to tools they invoke
ahos:captureSkill   ahos:invokes ahos:captureTool .
ahos:dosEodSkill    ahos:invokes ahos:searchKnowledgeTool, ahos:getArtifactTool, ahos:createExternalLinkTool .
ahos:dosPrepSkill   ahos:invokes ahos:searchKnowledgeTool, ahos:getArtifactTool .

# --- Six memory-store roles ---

ahos:routingRole a ahos:MemoryRole ;
    rdfs:label "routing role" ;
    rdfs:comment "Where to put / file / find things. Read by capture + filing skills; fed by log. ahOS mapping: capture_preferences." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:mapRole a ahos:MemoryRole ;
    rdfs:label "map role" ;
    rdfs:comment "Structure / topology of where knowledge lives. Read by nav / retrieval skills; fed by log. ahOS mapping: artifact_external_links + entities." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:logRole a ahos:MemoryRole ;
    rdfs:label "log role" ;
    rdfs:comment "OS log — the write-ahead record. Read by dos-eod; fed by all dos-* + /capture. ahOS mapping: artifacts table." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:stateRole a ahos:MemoryRole ;
    rdfs:label "state role" ;
    rdfs:comment "Synthesised 'now' — current state of play. Read by prep + planning + boss-mode; fed by log via dos-eod. ahOS mapping: Notion State Doc (the per-domain state docs)." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:structuredRole a ahos:MemoryRole ;
    rdfs:label "structured role" ;
    rdfs:comment "Organised long-term memory (PKM, PARA). Read by reference lookups; fed by filing / capture. ahOS mapping: Notion PARA + PARAMPS entities graph." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:archiveRole a ahos:MemoryRole ;
    rdfs:label "archive role" ;
    rdfs:comment "Unstructured long-term dump. Rare retrieval; fed by /capture --throw. ahOS mapping: long-tail artifacts + (future) cold store." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

# Wire memory-roles to their realising stores
ahos:capturePreferencesTable    ahos:playsRole ahos:routingRole .
ahos:artifactExternalLinksTable ahos:playsRole ahos:mapRole .
ahos:entitiesTable              ahos:playsRole ahos:mapRole, ahos:structuredRole .
ahos:artifactsRegister          ahos:playsRole ahos:logRole, ahos:archiveRole .
ahos:personalStateDoc           ahos:playsRole ahos:stateRole .
ahos:workStateDoc            ahos:playsRole ahos:stateRole .
ahos:workDrive               ahos:playsRole ahos:structuredRole .

# --- relationType tagging for the new properties (#74 extension) ---

ahos:exposes      ahos:relationType ahos:Hierarchy .
ahos:invokes      ahos:relationType ahos:Flow .
ahos:writesTo     ahos:relationType ahos:Flow .
ahos:readsFrom    ahos:relationType ahos:Flow .
ahos:playsRole    ahos:relationType ahos:Relation .
ahos:builtFrom    ahos:relationType ahos:Relation .
ahos:hostedBy     ahos:relationType ahos:Relation .
ahos:syncedTo     ahos:relationType ahos:Flow .
ahos:surface      ahos:relationType ahos:Relation .

# =====================================================================
# Tier 1: external systems, Notion DBs, Artifact instance, prov:wasDerivedFrom
# =====================================================================

# --- External systems (platforms ahOS integrates with) ---

ahos:notion a ahos:ExternalSystem ;
    rdfs:label "Notion" ;
    rdfs:comment "Notion (the SaaS app). Working-state surface per ADR-013. Hosts the per-user databases listed in ahos:userIntegrationsTable." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:googleDrive a ahos:ExternalSystem ;
    rdfs:label "Google Drive" ;
    rdfs:comment "Google Drive platform. The only ExternalSystem with a built ReadAdapter today (per ADR-016)." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:gmail a ahos:ExternalSystem ;
    rdfs:label "Gmail" ;
    rdfs:comment "Gmail platform. No server-side ReadAdapter yet — discovery path queued (#54)." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:slack a ahos:ExternalSystem ;
    rdfs:label "Slack" ;
    rdfs:comment "Slack platform. MCP wired; discovery / ingestion not built." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:github a ahos:ExternalSystem ;
    rdfs:label "GitHub" ;
    rdfs:comment "GitHub platform — code + issues. Issues track planning per ADR-014's lane separation. ahkmsRepo + dotclaudeRepo live here." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:googleCalendar a ahos:ExternalSystem ;
    rdfs:label "Google Calendar" ;
    rdfs:comment "Google Calendar platform. Source of events (meetings → meeting notes pathway)." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

# Existing Drive KnowledgeStores live in googleDrive
ahos:personalDrive ahos:livesIn ahos:googleDrive .
ahos:workDrive  ahos:livesIn ahos:googleDrive .

# --- Notion-specific databases (the working-state surface per ADR-013) ---

ahos:notionDailyLogDBPersonal a ahos:NotionDatabase ;
    rdfs:label "Notion — Daily Log (personal)" ;
    rdfs:comment "Daily Log database for the personal domain. Written by dos-eod (per ADR-018 §7)." ;
    ahos:livesIn ahos:notion ;
    ahos:hasDomain ahos:personal ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:notionDailyLogDBWork a ahos:NotionDatabase ;
    rdfs:label "Notion — Daily Log (work)" ;
    rdfs:comment "Daily Log database for the work domain. Written by dos-eod." ;
    ahos:livesIn ahos:notion ;
    ahos:hasDomain ahos:work ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:notionStateDocDBPersonal a ahos:NotionDatabase ;
    rdfs:label "Notion — State Doc DB (personal)" ;
    rdfs:comment "State Doc container for personal domain. Realises the ahos:personalStateDoc product." ;
    ahos:livesIn ahos:notion ;
    ahos:hasDomain ahos:personal ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:notionStateDocDBWork a ahos:NotionDatabase ;
    rdfs:label "Notion — State Doc DB (work)" ;
    rdfs:comment "State Doc container for work domain. Realises the ahos:workStateDoc product." ;
    ahos:livesIn ahos:notion ;
    ahos:hasDomain ahos:work ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:notionTasksDB a ahos:NotionDatabase ;
    rdfs:label "Notion — Tasks DB" ;
    rdfs:comment "Tasks database. Working-state for actions per ADR-013. /create-task writes here." ;
    ahos:livesIn ahos:notion ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:notionMeetingsDB a ahos:NotionDatabase ;
    rdfs:label "Notion — Meetings DB" ;
    rdfs:comment "Meetings database. Each row a meeting note; can be linked to artifacts via artifact_external_links." ;
    ahos:livesIn ahos:notion ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:notionInvestorCRM a ahos:NotionDatabase ;
    rdfs:label "Notion — Investor CRM" ;
    rdfs:comment "Investor relationship management database. work-scoped." ;
    ahos:livesIn ahos:notion ;
    ahos:hasDomain ahos:work ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

# Wire products to their realising stores
ahos:personalStateDoc ahos:partOf ahos:notionStateDocDBPersonal .
ahos:workStateDoc  ahos:partOf ahos:notionStateDocDBWork .

# --- Example artifact (and a derivation demo) ---

ahos:exampleMeetingNote a ahos:Artifact ;
    rdfs:label "Example meeting note" ;
    rdfs:comment "Illustrative artifact — a meeting note captured via web upload. task-b is prov:wasDerivedFrom it. Shows the lineage pattern." ;
    ahos:capturedVia ahos:WebUploadPath ;
    ahos:storageLocation "supabase://artifacts/example-meeting-note.md" ;
    ahos:hasDomain ahos:personal ;
    ahos:status ahos:Done ;
    ahos:preservationLevel ahos:Permanent ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

# task-b derives from the meeting note (ADR-033 / #193: prov:wasDerivedFrom, adopted direct)
ahos:task-b prov:wasDerivedFrom ahos:exampleMeetingNote .

# Tier 1 relationType tagging
ahos:livesIn         ahos:relationType ahos:Hierarchy .
prov:wasDerivedFrom  ahos:relationType ahos:Flow .

# =====================================================================
# Tier 2: synthesis machinery, discovery machinery, architectural layers
# =====================================================================

# --- Lifecycle stages (#16 — per ADR-016) ---

ahos:Discovered a ahos:LifecycleStage ; rdfs:label "discovered" ; rdfs:comment "Pointer exists; bytes not yet fetched."  ; ahos:level "instance" ; ahos:inBox "ABox" .
ahos:Extracted  a ahos:LifecycleStage ; rdfs:label "extracted"  ; rdfs:comment "Bytes fetched and text extracted."         ; ahos:level "instance" ; ahos:inBox "ABox" .
ahos:Uploaded   a ahos:LifecycleStage ; rdfs:label "uploaded"   ; rdfs:comment "Bytes uploaded directly (no discovery)."   ; ahos:level "instance" ; ahos:inBox "ABox" .
ahos:Processed  a ahos:LifecycleStage ; rdfs:label "processed"  ; rdfs:comment "Enrichment complete: entities resolved, links set." ; ahos:level "instance" ; ahos:inBox "ABox" .

# --- Read adapters ---

ahos:googleDriveReadAdapter a ahos:ReadAdapter ;
    rdfs:label "Google Drive read adapter" ;
    rdfs:comment "The only ReadAdapter built today. Per ADR-016 the discover loop uses this to fetch Drive bytes on the enrich pass." ;
    ahos:readsFrom ahos:googleDrive ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

# Inverse-direction assertion (added with D-I fold-in, part 2):
# only Drive carries this triple — see ahos:hasReadAdapter for the open-world
# interpretation of the gap for Notion / Gmail / Slack / GitHub / Calendar.
ahos:googleDrive ahos:hasReadAdapter ahos:googleDriveReadAdapter .

# --- Architectural layers ---

ahos:OperatingLayer a ahos:ArchLayer ;
    rdfs:label "Operating Layer" ;
    rdfs:comment "Capabilities (skills, agents, commands) — the things that USE the system. Editable opinions per ADR-014. Live in dotclaude today; per ADR-019 they migrate to ahkms with serving + bindings." ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:SubstrateLayer a ahos:ArchLayer ;
    rdfs:label "Substrate Layer" ;
    rdfs:comment "Tools, tables, stores — the things capabilities ACT ON. Stable, schema'd, durable. The substrate ADR-016 names as 'we have already built it.'" ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

# Tag classes with their layer
ahos:Capability ahos:inLayer ahos:OperatingLayer .
ahos:MCPTool    ahos:inLayer ahos:SubstrateLayer .
ahos:Table      ahos:inLayer ahos:SubstrateLayer .
ahos:Database   ahos:inLayer ahos:SubstrateLayer .
ahos:KnowledgeStore ahos:inLayer ahos:SubstrateLayer .

# Mark dos-eod as also a Synthesiser (multi-typing)
ahos:dosEodSkill a ahos:Synthesiser .

# Tier 2 relationType tagging
ahos:lifecycleStage ahos:relationType ahos:Hierarchy .

# =====================================================================
# Tier 3: people, content subtypes, correspondence edge, bindings
# =====================================================================

# --- Team + people ---

ahos:workTeam a ahos:Team ;
    rdfs:label "Work Team" ;
    rdfs:comment "The Work team — people Angus collaborates with on work-domain work." ;
    ahos:hasDomain ahos:work ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:angus ahos:memberOf ahos:workTeam .

ahos:exampleContact a schema:Person ;
    rdfs:label "Example contact" ;
    schema:name "Example Contact" ;
    rdfs:comment "Placeholder example contact (a colleague). Demonstrates the People dimension — real contacts would replace this when wired to a real contact source." ;
    ahos:memberOf ahos:workTeam ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

# --- Content subtypes (the kinds of content an Artifact can carry) ---

ahos:Note         a ahos:ContentSubtype ; rdfs:label "Note"         ; rdfs:comment "Free-text note / jotting."          ; ahos:level "instance" ; ahos:inBox "ABox" .
ahos:Transcript   a ahos:ContentSubtype ; rdfs:label "Transcript"   ; rdfs:comment "Meeting / call transcript."          ; ahos:level "instance" ; ahos:inBox "ABox" .
ahos:Conversation a ahos:ContentSubtype ; rdfs:label "Conversation" ; rdfs:comment "Agent chat conversation."           ; ahos:level "instance" ; ahos:inBox "ABox" .
ahos:VoiceNote    a ahos:ContentSubtype ; rdfs:label "VoiceNote"    ; rdfs:comment "Voice recording (transcribed later)." ; ahos:level "instance" ; ahos:inBox "ABox" .
ahos:Image        a ahos:ContentSubtype ; rdfs:label "Image"        ; rdfs:comment "Photograph / screenshot."           ; ahos:level "instance" ; ahos:inBox "ABox" .
ahos:Handwriting  a ahos:ContentSubtype ; rdfs:label "Handwriting"  ; rdfs:comment "Handwritten note (often via Image)." ; ahos:level "instance" ; ahos:inBox "ABox" .
ahos:Letter       a ahos:ContentSubtype ; rdfs:label "Letter"       ; rdfs:comment "Formal letter / correspondence."     ; ahos:level "instance" ; ahos:inBox "ABox" .

# Apply to existing example artifact
ahos:exampleMeetingNote ahos:contentSubtype ahos:Transcript .

# --- Correspondence channels + send tools (ADR-017) ---

ahos:gmailChannel       a ahos:Channel ; rdfs:label "Gmail"          ; ahos:level "instance" ; ahos:inBox "ABox" .
ahos:linkedInChannel    a ahos:Channel ; rdfs:label "LinkedIn"       ; ahos:level "instance" ; ahos:inBox "ABox" .
ahos:xChannel           a ahos:Channel ; rdfs:label "X (Twitter)"    ; rdfs:comment "LinkedIn DM excluded per ADR-017." ; ahos:level "instance" ; ahos:inBox "ABox" .
ahos:instagramChannel   a ahos:Channel ; rdfs:label "Instagram"      ; ahos:level "instance" ; ahos:inBox "ABox" .
ahos:whatsappChannel    a ahos:Channel ; rdfs:label "WhatsApp"       ; ahos:level "instance" ; ahos:inBox "ABox" .

ahos:sendEmailTool a ahos:SendTool ;
    rdfs:label "send_email" ;
    rdfs:comment "MCP tool that sends Gmail via Composio. Used by ahos:correspondenceSkill." ;
    ahos:sendsVia ahos:gmailChannel ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:postLinkedInTool a ahos:SendTool ;
    rdfs:label "post_linkedin" ;
    rdfs:comment "MCP tool that posts to LinkedIn via Composio." ;
    ahos:sendsVia ahos:linkedInChannel ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:sendWhatsAppTool a ahos:SendTool ;
    rdfs:label "send_whatsapp" ;
    rdfs:comment "MCP tool that sends WhatsApp via Composio (within compliant message window)." ;
    ahos:sendsVia ahos:whatsappChannel ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

# Composio — the rented connector aggregator
ahos:composio a ahos:ExternalSystem ;
    rdfs:label "Composio" ;
    rdfs:comment "Rented connector aggregator per ADR-017 — handles OAuth, rate limits, API churn for outbound channels. Free tier today (~$0–5/month)." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

# Correspondence skill (composes send-tools + read-side retrieval)
ahos:correspondenceSkill a ahos:Skill ;
    rdfs:label "/correspondence" ;
    rdfs:comment "The correspondence edge per ADR-017. Composes send-tools + ahos:searchKnowledgeTool to draft + send grounded messages. Deletable: removing it does not affect the knowledge core. **Hosting/deployment** [resolved 2026-06-16]: today ahos:hostedBy ahos:dotclaudeRepo (source of truth) + ahos:syncedTo ahos:perRepoClaudeDir (web-fetched into each consuming repo's .claude/skills/ at the Claude Code surface). Future state per ADR-019 (contingent on acceptance + ahkms serving API being built): ahos:hostedBy ahos:ahkmsRepo + ahos:syncedTo ahos:ahkmsServingEndpoint. Same future-state contingencies apply to all dotclaude-hosted owned skills." ;
    ahos:surface ahos:ClaudeCodeSurface ;
    ahos:hostedBy ahos:dotclaudeRepo ;
    ahos:syncedTo ahos:perRepoClaudeDir ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:correspondenceSkill ahos:invokes ahos:searchKnowledgeTool, ahos:getArtifactTool .
ahos:correspondenceSkill ahos:invokes ahos:sendEmailTool, ahos:postLinkedInTool, ahos:sendWhatsAppTool .

# --- Thesis (the founding assertion of what ahOS is) ---

ahos:UnifiedKnowledgeManagementSystem a ahos:ThesisStatement ;
    rdfs:label "ahOS is a unified knowledge management system" ;
    rdfs:comment "Founding thesis (brainstorm 2026-06-15): ahOS is a *unified* knowledge management system — a single coherent layer that tracks knowledge across the many places and moments where it arises, including capabilities (skills are knowledge too). It is not one more silo alongside Notion, Drive, Gmail etc.; it is the map across them. Anchors ahos:MapDontStore (the architectural principle that follows from it), ahos:R1UniversalAccess (the access contract it implies), and ahos:SkillsAsKnowledge (the scope-broadening principle that makes 'knowledge' include capabilities). Folded from brainstorm lines 15-18." ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

# --- Principles (load-bearing design rules) ---

ahos:MapDontStore a ahos:Principle ;
    rdfs:label "Map don't store" ;
    rdfs:comment "Hold the map of what exists and where; bytes can live in their native homes. Echoes ADR-016 'Registry, not Store'. Vision-level principle." ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:RegistryNotStore a ahos:Principle ;
    rdfs:label "Registry, not Store" ;
    rdfs:comment "ADR-016: the substrate is a registry of where knowledge lives, not a hoarder of all bytes." ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:CaptureIsDumb a ahos:Principle ;
    rdfs:label "Capture is dumb" ;
    rdfs:comment "ADR-013 §1 + ADR-018 §2. Capture writes faithfully without inference; interpretive work is a separate explicit step at synthesis time." ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:BuildOpinionsRentMechanics a ahos:Principle ;
    rdfs:label "Build opinions, rent mechanics" ;
    rdfs:comment "ADR-012 + ADR-017. Knowledge layer = opinion (we build); connectors / posting = mechanics (we rent). Composio embodies this on the correspondence edge." ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:DeletableEdgeRule a ahos:Principle ;
    rdfs:label "Deletable edge rule" ;
    rdfs:comment "ADR-017 boundary rule: the correspondence edge (skill + send-tools) reads the knowledge core only through MCP/retrieval contract. Test: delete the edge and the knowledge system must still build and run unchanged." ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:NeverForget a ahos:Principle ;
    rdfs:label "Never forget anything ever again" ;
    rdfs:comment "North-star principle: the system's job is to make forgetting structurally impossible. Capture must not drop anything; retrieval must surface what was captured regardless of where it lives. Anchors R2 (seamless capture) and is upstream of R1 (universal access). Folded in from branch A of version A." ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:SkillsAsKnowledge a ahos:Principle ;
    rdfs:label "Capabilities are knowledge" ;
    rdfs:comment "Thesis extension: a skill, agent, or command is itself a knowledge artifact — versioned, queryable, and discoverable through the same interfaces that surface captured knowledge. Anchors ADR-019 (capability hosting + binding layer) and R5. Folded in from branch A of version A." ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:SingleSourceOfTruth a ahos:Principle ;
    rdfs:label "Single source of truth" ;
    rdfs:comment "Each piece of knowledge has one canonical home — its provenance is unambiguous. Operates at the level of the *map* (the registry of what exists and where), not the *content* (which can live in any native store). ahos:CentraliseMapDisperseContent is the reframing that resolves the apparent tension with ahos:MapDontStore — flagged in A's branch B as q-sot-vs-map (\"is single-SoT compatible with bytes dispersed across native stores?\"); the answer is yes, because the map is what's single-SoT, not the bytes. Folded in from branch B of version A." ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:Additive a ahos:Principle ;
    rdfs:label "Additive, not re-architecture" ;
    rdfs:comment "Substrate changes must add capability without breaking what works. ADR-016 made this a binding constraint: the registry layer extends artifacts / artifact_external_links / entities, it does not replace them. New ADRs land as new tables, new columns, or new opt-in pathways, not rewrites. A's branch B flagged q-additive-decisions — open whether the rule also binds at the *decision* level (no architectural about-faces once shipped) or only at the code/schema level. Folded in from branch B of version A." ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:SynthesisTimeInterpretation a ahos:Principle ;
    rdfs:label "Synthesis-time interpretation" ;
    rdfs:comment "All interpretive work — entity resolution, classification, lens application, summarisation — happens at synthesis / read time, not at capture. ADR-018 §4. The structural complement of ahos:CaptureIsDumb: if capture doesn't interpret, synthesis must. Lets the captured record stay faithful while the meaning of that record is free to evolve as the interpretive layer improves. Folded in from branch B of version A." ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:PositiveFactStoreDeriveRest a ahos:Principle ;
    rdfs:label "Store positive fact, derive rest" ;
    rdfs:comment "Store the affirmative event (\"artifact X was consumed at T by Y\"); derive negatives by absence (\"not_consumed\" = no positive fact exists). ADR-013 §7. Avoids storing the cross-product of (artifact × possible-consumer) and makes consumption append-only and conflict-free. Implements ahos:CaptureIsDumb on the consumption side: the marker records what happened, not interpretive judgements about what it means. Folded in from branch B of version A." ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:CentraliseMapDisperseContent a ahos:Principle ;
    rdfs:label "Centralise the map, disperse the content" ;
    rdfs:comment "The map (registry of what exists and where) is centralised — one home, queryable, owned by ahkms. The content (bytes themselves) is dispersed — lives in native stores (Drive, Notion, Gmail, …) and is accessed through ReadAdapters when needed. ADR-016 §3. Reframes ahos:SingleSourceOfTruth as \"single SoT applies to the *map*, not the content\" and pins down ahos:MapDontStore by specifying *what* gets mapped and *where the bytes are*. Folded in from branch B of version A." ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:AtomicCapture a ahos:Principle ;
    rdfs:label "Atomic capture (one event/thought per artifact)" ;
    rdfs:comment "One captured artifact = one event or thought. The /capture skill is responsible for segmentation (inline mode walks typed content, bare mode walks back to a topic boundary); the persistence layer never merges or splits. ADR-018 §2. Enables downstream reasoning over discrete atoms — search, lineage, consumption-markers — rather than over ambiguous multi-topic blobs. Attributed to branch D of version A (where the capture pipeline lives), folded here with the rest of the principles." ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:ThreeLevels a ahos:Principle ;
    rdfs:label "Three levels: framework → type → instance" ;
    rdfs:comment "Knowledge organisation works at three nested levels: a framework (PARA, PARAMPS, work-team-os) defines a vocabulary of types; a type (Project, Area, Person) is a category within that vocabulary; an instance (Wedding-2026, EHS-policy, ahos:angus) is a specific thing typed by that category. The framework decides what types exist; the type decides what attributes apply; the instance carries the actual data. PARA-as-framework × Project-as-type × Wedding-2026-as-instance is the canonical illustration — runtime instances of that shape live in the live entity graph, not here in the schema. Folded in from branch O of version A; structurally similar to the two-axis design (Category + Domain) but pitched at the runtime entity level, not the substrate vocabulary level." ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

# --- Principles folded in from branches D-I of version A ---

ahos:TwoCadence a ahos:Principle ;
    rdfs:label "Two-cadence model (cheap-frequent + expensive-selective)" ;
    rdfs:comment "Discover and Enrich are separate capabilities run on different cadences: Discover is cheap and frequent (refresh the registry of what exists); Enrich is expensive and selective (fetch bytes, extract text, embed, resolve entities) and only runs on a budgeted subset per pass. ADR-016. Explains why the substrate has both a discovered-only pointer state and a fully-enriched artifact state — they're outputs of different passes, not stages of one. Closes the question \"why don't we just enrich everything at discover time?\": cost. Folded in from branch E of version A." ;
    ahos:level "ontology" ; ahos:inBox "ABox" .

ahos:MemoryVsStateSplit a ahos:Principle ;
    rdfs:label "Memory vs working-state split" ;
    rdfs:comment "Two distinct roles, two distinct substrates: Memory (\"what do I know?\") lives in the ahkms substrate (artifacts / entities / artifact_external_links); Working-state (\"what am I doing right now?\") lives in Notion (the State Docs). ADR-013 §2. The split is load-bearing because the access patterns differ — memory is append-only and atomic, state is mutable and rolled up. Consumption-markers (ADR-013 §7) are how the two sides stay coherent without either owning the other. Folded in from branch F of version A." ;
    ahos:level "ontology" ; ahos:inBox "ABox" .

ahos:CrossStoreLineage a ahos:Principle ;
    rdfs:label "Cross-store lineage > joins" ;
    rdfs:comment "Identity of a thing across stores is carried by an (provider, kind, external_id) tuple in artifact_external_links, not by joins on shared content. Lets the same logical artifact appear in Drive + Notion + Gmail without any of them needing to know about the others. Realises ahos:R1UniversalAccess at the substrate level: \"get X\" can resolve regardless of which store currently holds the bytes. Folded in from branch F of version A." ;
    ahos:level "ontology" ; ahos:inBox "ABox" .

ahos:HostVsIndex a ahos:Principle ;
    rdfs:label "Host vs index (ahkms hosts owned, indexes the rest)" ;
    rdfs:comment "ahkms hosts the capabilities it owns (its own skills, the kms MCP server) and indexes everything else (cowork skills, external systems, third-party tools). Hosting means \"runs here and is authoritative\"; indexing means \"recorded here as a pointer to where it actually lives\". ADR-019. The principle decides what crosses the trust boundary into ahkms's own runtime vs what stays a referenced thing. Distinguishes ahos:KnowledgeStore (a place that holds bytes) from ahos:Capability hosted-by-vs-not-hosted-by ahkms. Folded in from branch H of version A." ;
    ahos:level "ontology" ; ahos:inBox "ABox" .

ahos:SecretsInEnv a ahos:Principle ;
    rdfs:label "Secrets stay in env (bindings never resolve secrets)" ;
    rdfs:comment "Bindings (ADR-019's named-pointer config layer) resolve to public identifiers — workspace IDs, database IDs, channel names — never to secrets. API keys, tokens, and credentials stay in environment variables, fetched at runtime from process env, never written into the bindings table or any ontology node. Security invariant: a leaked bindings dump exposes structure, not access. Folded in from branch H of version A." ;
    ahos:level "ontology" ; ahos:inBox "ABox" .

ahos:FailLoud a ahos:Principle ;
    rdfs:label "Fail-loud on missing binding" ;
    rdfs:comment "If a skill references a binding (a `{{ref}}` token) and that binding is unresolved at serve time, the skill fails immediately with a clear error — it does not silently substitute a default, skip the section, or proceed with an empty value. Treats config-plumbing failures as bugs to surface, not as edge cases to tolerate. Folded in from branch H of version A." ;
    ahos:level "ontology" ; ahos:inBox "ABox" .

ahos:KnowledgeGrounded a ahos:Principle ;
    rdfs:label "Knowledge-grounded (read via the MCP contract)" ;
    rdfs:comment "Capabilities that reach into stored knowledge — correspondence, dos-eod, weekly-reflection, anything that composes a message or report from what ahOS knows — read exclusively via the kms MCP contract (search_knowledge, get_artifact, …). They do not bypass to the substrate, they do not duplicate the read path, they do not hold their own cache of the underlying data. Locks the substrate→consumer boundary cleanly and makes the consumer side deletable without touching the substrate (ADR-017's boundary rule). Folded in from branch I of version A." ;
    ahos:level "ontology" ; ahos:inBox "ABox" .

ahos:HumanPreview a ahos:Principle ;
    rdfs:label "Human preview required (outbound side)" ;
    rdfs:comment "Anything correspondence-skill produces that leaves ahOS (an email, a LinkedIn post, a WhatsApp message) requires human review before sending. The send tools (send_email / post_linkedin / send_whatsapp / …) are wired through a preview step; no autonomous send path exists at the design level. Safety rail on the only edge of the system that can act outwardly without retraction. Folded in from branch I of version A." ;
    ahos:level "ontology" ; ahos:inBox "ABox" .

ahos:ThreeLanesOfRecord a ahos:Principle ;
    rdfs:label "Three lanes of record (docs / ADRs / Issues)" ;
    rdfs:comment """The project's planning and documentation runs in three distinct lanes, each with its own mutability profile and authority:

  | Lane              | Folder                   | Mutability                  | Authority           |
  | current state     | docs/                    | Living                      | What IS, today      |
  | why (decisions)   | docs/ADRs/               | Immutable once Accepted     | Why it is that way  |
  | planning          | GitHub Issues            | Ephemeral (closes when done)| What we're doing    |

Mixing the lanes — recording a plan in docs/, live current state in an ADR, or canonical why in an Issue — causes the wrong half to rot. docs/ describes today; ADRs preserve the reasoning trail; Issues track work-in-flight and close out. This is the project's load-bearing separation-of-concerns rule; it sits one level below the ontology proper (it's about the meta-system that hosts the ontology, but it shapes how everything in the ontology gets recorded and superseded). Folded in from branch N of version A (N1).""" ;
    ahos:level "ontology" ; ahos:inBox "ABox" .

# --- Requirements (R1-R5 from the 2026-06-15 brainstorm, branch C) ---

ahos:R1UniversalAccess a ahos:Requirement ;
    rdfs:label "R1 Universal access" ;
    rdfs:comment "\"Get X\" works regardless of where X physically lives. Realised by the map-don't-store substrate — artifact_external_links carries cross-store lineage, search_knowledge and get_artifact (MCP) surface the result. Anchoring principle: MapDontStore." ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:R2NeverForget a ahos:Requirement ;
    rdfs:label "R2 Seamless capture (the operational form of Never Forget)" ;
    rdfs:comment "Capture must be seamless and low-friction: the agent reads enough context to route each incoming item to the correct destination automatically, without user intervention, and nothing is dropped. The operational, testable expression of ahos:NeverForget — NeverForget names the aspiration; R2 names the obligation. Wired below via ahos:realises to ahos:NeverForget and ahos:CaptureIsDumb (the design rules) and ahos:captureSkill / ahos:captureTool (the substrate). Open: the context-aware *routing* obligation has no dedicated Capability node yet — a CaptureRouter would be the natural home." ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:R3GuidedStorageAndProcessing a ahos:Requirement ;
    rdfs:label "R3 Guided, context-aware storage & processing" ;
    rdfs:comment "Storage and processing of captured knowledge must be guided by the user's context — inferred from what the system knows about the user and the item — not left to manual filing decisions. The system determines appropriate placement and handling without requiring the user to specify it. Realised today by ahos:SynthesisTimeInterpretation (ADR-018 §4: interpretation at read/synthesis time) + PARAMPS entity routing in the entities table; the precise contract for *what context signals drive routing* remains underspecified and is not yet captured as a dedicated ahos:OpenQuestion. The word 'guided' is itself ambiguous — agent-prompting-the-user (a manual filing prompt: 'should this go in home/?') vs system-auto-routing-from-context (the synthesis-time interpretation pathway). The current ahos:SynthesisTimeInterpretation realisation leans toward auto-route; the prompt-the-user variant remains a candidate UX path. Folded from consolidated-mess section C open (2026-06-15)." ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:R4StateDoc a ahos:Requirement ;
    rdfs:label "R4 State doc / current truth" ;
    rdfs:comment "Per-thing view of current truth (\"what's the state of project X right now?\"). Realised by the working-state docs (Notion) and the memory-vs-state split from ADR-013 §2; §7 consumption-marker substrate is how state-doc updates reach back to the memory side. Open question: one state doc or many — per project/area/topic?" ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:R5CapabilitiesAccessibleSameWay a ahos:Requirement ;
    rdfs:label "R5 Capabilities accessible the same way (implicit)" ;
    rdfs:comment "Implicit requirement extracted from the SkillsAsKnowledge thesis: a skill, agent, or command should be findable and invocable through the same interfaces that surface knowledge artifacts. Wired below via ahos:realises to SkillsAsKnowledge (the design rule) and ADR-019 (the capability hosting + binding layer that delivers it). Proposed realiser (design-ontology Phase 2 fold, 2026-06-15): 'capability-as-artifact-metadata' — a future construct that would index capabilities the same way artifacts are indexed (FTS over capability descriptions, structured filters over capability kind/surface/scope, lineage via artifact_external_links). Would close R5 and ahos:Q13SkillsAsParampsEntities together. Not yet built; ahos:UnifiedQueryableKnowledgeLimitation names the current gap." ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

# Wire R2 and R5 to their realisers (principles + substrate)
ahos:NeverForget        ahos:realises ahos:R2NeverForget .
ahos:CaptureIsDumb      ahos:realises ahos:R2NeverForget .
ahos:captureSkill       ahos:realises ahos:R2NeverForget .
ahos:captureTool        ahos:realises ahos:R2NeverForget .

ahos:SkillsAsKnowledge  ahos:realises ahos:R5CapabilitiesAccessibleSameWay .
ahos:ADR019             ahos:realises ahos:R5CapabilitiesAccessibleSameWay .

# Wire R1 and R3 (added when branches A+B principles were folded in)
ahos:MapDontStore                ahos:realises ahos:R1UniversalAccess .
ahos:CentraliseMapDisperseContent ahos:realises ahos:R1UniversalAccess .
ahos:SynthesisTimeInterpretation ahos:realises ahos:R3GuidedStorageAndProcessing .

# Wire R1, R4, R5 (added when D-I principles batch was folded in)
ahos:TwoCadence         ahos:realises ahos:R1UniversalAccess .
ahos:CrossStoreLineage  ahos:realises ahos:R1UniversalAccess .
ahos:MemoryVsStateSplit ahos:realises ahos:R4StateDoc .
ahos:HostVsIndex        ahos:realises ahos:R5CapabilitiesAccessibleSameWay .

# Tagging — realises is a flow-like relation (substrate delivers requirement)
ahos:realises           ahos:relationType ahos:Flow .

# --- Bindings (ADR-019) ---

ahos:BakeAtServe a ahos:BindingTiming ;
    rdfs:label "bake-at-serve" ;
    rdfs:comment "v1 per ADR-019: the API substitutes binding values at serve time and returns a concrete capability for the scope. Capability ships with values baked in." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:LateBind a ahos:BindingTiming ;
    rdfs:label "late-bind" ;
    rdfs:comment "Future per ADR-019: once ahkms is itself the executor, bindings resolve at execution time and capability stays templated." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

# Example bindings (notion.inbox_db resolves to different DBs per scope)
ahos:notionInboxDBBindingPersonal a ahos:Binding ;
    rdfs:label "{{notion.inbox_db}} @ personal" ;
    rdfs:comment "Resolves the notion.inbox_db reference for the personal scope. Per ADR-018 ADR's noted that dos-inbox retires; kept here as the structural example of how bindings work." ;
    ahos:bindingScope ahos:personal ;
    ahos:bindingTiming ahos:BakeAtServe ;
    ahos:resolvesTo ahos:notionDailyLogDBPersonal ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:notionInboxDBBindingWork a ahos:Binding ;
    rdfs:label "{{notion.inbox_db}} @ work" ;
    rdfs:comment "Same reference token, different scope → resolves to a different Notion DB. Demonstrates the per-scope binding pattern from ADR-019." ;
    ahos:bindingScope ahos:work ;
    ahos:bindingTiming ahos:BakeAtServe ;
    ahos:resolvesTo ahos:notionDailyLogDBWork ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

# Tier 3 relationType tagging
ahos:memberOf       ahos:relationType ahos:Relation .
ahos:contentSubtype ahos:relationType ahos:Hierarchy .
ahos:sourceQuality  ahos:relationType ahos:Hierarchy .
ahos:hasReadAdapter ahos:relationType ahos:Relation .
ahos:sendsVia       ahos:relationType ahos:Flow .
ahos:bindingScope   ahos:relationType ahos:Relation .
ahos:bindingTiming  ahos:relationType ahos:Relation .
ahos:resolvesTo     ahos:relationType ahos:Relation .

# =====================================================================
# Tier 4 (speculative): knowledge tiers, time periods, decisions
# =====================================================================

# --- Knowledge tiers (brainstorm concept 9: Bronze/Silver/Gold) ---

ahos:Bronze a ahos:KnowledgeTier ;
    rdfs:label "Bronze" ;
    rdfs:comment "Low-importance tier. Most captured items default here. Indexed but not prioritised in retrieval." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:Silver a ahos:KnowledgeTier ;
    rdfs:label "Silver" ;
    rdfs:comment "Mid-importance. Promoted from Bronze when revisited, referenced, or surfaced by synthesisers more than once." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:Gold a ahos:KnowledgeTier ;
    rdfs:label "Gold" ;
    rdfs:comment "High-importance. Surfaces by default in retrieval; cited in state docs; reviewed regularly. Promoted from Silver." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

# --- Periods (brainstorm Q2 — instance-bound contexts) ---

ahos:periodMLG a ahos:Period ;
    rdfs:label "MLG era" ;
    rdfs:comment "The period during which 'home' was MLG. Council = Lambeth. Currency: started ~2020 (placeholder). Ended when home moved." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:periodCurrent a ahos:Period ;
    rdfs:label "current period" ;
    rdfs:comment "The current home-bound period. Whatever's true now; supersedes prior periods on rename." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

# --- Decisions (the ADR wave 013–020) ---

ahos:ADR013 a ahos:Decision ;
    rdfs:label "ADR-013" ;
    rdfs:comment "Capture Primitive + Memory/Working-State Split. Establishes the dumb-capture principle, memory-vs-state split, and §7 consumption-marker substrate." ;
    ahos:decides ahos:CaptureIsDumb ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:ADR016 a ahos:Decision ;
    rdfs:label "ADR-016" ;
    rdfs:comment "Discover & Index as first-class capability. Two-cadence model. Centralise the map, disperse the content." ;
    ahos:decides ahos:RegistryNotStore ;
    ahos:decides ahos:MapDontStore ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:ADR017 a ahos:Decision ;
    rdfs:label "ADR-017" ;
    rdfs:comment "Knowledge-grounded correspondence as an isolated edge. Establishes the deletable-edge boundary rule." ;
    ahos:decides ahos:DeletableEdgeRule ;
    ahos:decides ahos:BuildOpinionsRentMechanics ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:ADR018 a ahos:Decision ;
    rdfs:label "ADR-018" ;
    rdfs:comment "Unified Capture Surface + Synthesis-Time Interpretation. Reaffirms dumb-capture; consolidates /capture and dos-inbox; introduces atomic-capture + synthesis-time inference." ;
    ahos:decides ahos:CaptureIsDumb ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:ADR019 a ahos:Decision ;
    rdfs:label "ADR-019" ;
    rdfs:comment "Capability Hosting + Bindings. ahkms as auth'd home for owned skills; bindings layer ({{notion.inbox_db}}). Today: dotclaude hosts; future: ahkms serves." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:ADR020 a ahos:Decision ;
    rdfs:label "ADR-020" ;
    rdfs:comment "Open contradictions across ADR-013 to ADR-019 — register + resolution log. Meta-ADR." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

# --- Contradictions register (branch M of version A; registered in ADR-020) ---
# Each Contradiction is ahos:partOf the ADR-020 register, carries ahos:status
# (Open or Resolved), and where the contested subject exists as an Entity in
# this ontology, points at it via ahos:about. Resolved ones add ahos:resolvedBy
# pointing at the Decision (ADR or principle landing) that closed them.

ahos:B1SynthesisSurface a ahos:Contradiction ;
    rdfs:label "B1 PR#25 vs PR#59 synthesis-surface design" ;
    rdfs:comment "Two alternative designs for the synthesis-surface MCP path — PR#25's create_external_link (generic consumption-marker writer) vs PR#59's mark_consumed (specific tool). Open; the choice cascades to ADR-018." ;
    ahos:partOf ahos:ADR020 ;
    ahos:status ahos:Open ;
    ahos:about  ahos:createExternalLinkTool ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:B2SkillHome a ahos:Contradiction ;
    rdfs:label "B2 three positions on skill home" ;
    rdfs:comment "Three live positions on where skills should be hosted (dotclaude, ahkms, hybrid). Depends on ADR-019 ratification — once the capability hosting + binding layer is canonical, B2 closes." ;
    ahos:partOf ahos:ADR020 ;
    ahos:status ahos:Open ;
    ahos:about  ahos:ADR019 ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:B3ADR019HistoricalRefs a ahos:Contradiction ;
    rdfs:label "B3 ADR-019 hangs off historical drafts" ;
    rdfs:comment "ADR-019 references historical-draft ADR-014 in places where it should reference the canonical ADR-019 only. Small edit when re-touched; flagged so it doesn't get lost." ;
    ahos:partOf ahos:ADR020 ;
    ahos:status ahos:Open ;
    ahos:about  ahos:ADR019 ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:C2CapabilityAxesVerbs a ahos:Contradiction ;
    rdfs:label "C2 capability-axes verbs unsettled" ;
    rdfs:comment "The verbs used by docs/architecture/capability-axes.md (capture / discover / index / enrich / store / retrieve / synthesise / correspond) aren't settled across ADRs and skill docs. Low priority — settles when the capability taxonomy is promoted to a canonical ADR." ;
    ahos:partOf ahos:ADR020 ;
    ahos:status ahos:Open ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:C3CaptureKGGap a ahos:Contradiction ;
    rdfs:label "C3 ADR-018 doesn't reference KG tools" ;
    rdfs:comment "ADR-018 (capture + synthesis-time interpretation) doesn't reference the knowledge-graph tools (entities table, entity_relationships, per-atom-inference). One-paragraph note needed." ;
    ahos:partOf ahos:ADR020 ;
    ahos:status ahos:Open ;
    ahos:about  ahos:ADR018 ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:C4LifecycleStageChatPath a ahos:Contradiction ;
    rdfs:label "C4 lifecycle_stage on chat-capture path" ;
    rdfs:comment "Lifecycle-stage values (Discovered / Extracted / Filed / Processed) were designed for the discover-and-index pipeline. The chat-capture path skips most stages but still has to write a stage value — unclear what." ;
    ahos:partOf ahos:ADR020 ;
    ahos:status ahos:Open ;
    ahos:about  ahos:LifecycleStage ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:C1HistoricalDraftStaleness a ahos:Contradiction ;
    rdfs:label "C1 historical-draft staleness (resolved)" ;
    rdfs:comment "Two ADRs were drafted as ADR-013 / ADR-014 on a WIP branch but never canonically merged. Resolved by archiving them to docs/architecture/historical/ with supersession headers." ;
    ahos:partOf ahos:ADR020 ;
    ahos:status ahos:Resolved ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:C5DotclaudePR4 a ahos:Contradiction ;
    rdfs:label "C5 dotclaude PR #4 reconciliation (resolved)" ;
    rdfs:comment "Tension between dotclaude PR #4's design and the synthesis-time-interpretation principle. Resolved when synthesis-time-interpretation was made the canonical pattern (ADR-018)." ;
    ahos:partOf ahos:ADR020 ;
    ahos:status ahos:Resolved ;
    ahos:resolvedBy ahos:ADR018 ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:H1NumberingDoubleBook a ahos:Contradiction ;
    rdfs:label "H1 ADR numbering double-book (resolved)" ;
    rdfs:comment "Two PRs both tried to take the ADR-013 / ADR-014 numbers. Resolved by claiming canonical slots on merge and archiving the rejected drafts under historical/." ;
    ahos:partOf ahos:ADR020 ;
    ahos:status ahos:Resolved ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:H2PR58PR13Overlap a ahos:Contradiction ;
    rdfs:label "H2 PR #58 / PR #13 file overlap (resolved)" ;
    rdfs:comment "Two open PRs touched overlapping files. Resolved by sequencing — PR #58 lands first, PR #13 rebases on top." ;
    ahos:partOf ahos:ADR020 ;
    ahos:status ahos:Resolved ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:H3DocsReportsRename a ahos:Contradiction ;
    rdfs:label "H3 docs/Reports → docs/reports rename (resolved)" ;
    rdfs:comment "Case-sensitivity mismatch on docs/Reports vs docs/reports. Resolved with a standalone rename PR." ;
    ahos:partOf ahos:ADR020 ;
    ahos:status ahos:Resolved ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

# --- Open questions (branch L of version A; brainstorm origin, not ADR-020) ---
# Each OpenQuestion carries ahos:status and ahos:about. No ahos:partOf wiring —
# these come from the brainstorm rather than a register; if/when one gets
# registered (e.g. promoted into ADR-020 as a Contradiction) the relation can
# be added then. Q1 may collapse into the C3CaptureKGGap contradiction once
# the "artifact vs capture" distinction is settled (A's branch K flagged the
# overlap as 'likely collapse').

ahos:Q1ArtifactDerivedLifecycle a ahos:OpenQuestion ;
    rdfs:label "Q1 artifact vs derived-info lifecycle" ;
    rdfs:comment "Brainstorm Q1: do artifacts (the bytes you stored) and derived information (tasks, facts, state-doc updates extracted from them) share one lifecycle, or two? A meeting note → notion/meetings is one disposition; the tasks it spawned have a different one. The handwritten note gets archived; the facts it captured shouldn't. A third worked example clarifies the disposition decision: a council letter derives user-data (membership number → People profile), an action (contact MP → task), and the letter itself needs retention under home/council/correspondence — three sinks per artifact, not one. The per-artifact decision is therefore 'archive source vs file source for retention' independently of where derived facts/tasks land. Pointed at ahos:LifecycleStage because that's the concrete enum that would have to change shape if the answer is 'two lifecycles'. Likely collapses into ahos:C3CaptureKGGap once the artifact-vs-capture distinction is settled." ;
    ahos:about ahos:LifecycleStage ;
    ahos:status ahos:Open ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:Q2InstanceBoundFolderState a ahos:OpenQuestion ;
    rdfs:label "Q2 instance-bound folder state change" ;
    rdfs:comment "Brainstorm Q2: when 'home' was MLG and is now somewhere else, how do queries against today's state avoid picking up stale facts about the MLG era? Two modelling options surfaced: (a) manually archive the namespace (home/) at the moment of change and start fresh, vs (b) use instance-specific path prefixes (mlg/council/correspondence) from the start so the old path stays intact when the era ends. ahos:Period was added in Tier 4 as a candidate answer — tag instance-bound facts with the Period they belong to. The class exists; the question is whether Period as a metadata tag is sufficient, or whether paths themselves should encode the instance, or whether other concerns (PARA archive, retention-vs-archive distinction) also need to wire in." ;
    ahos:about ahos:Period ;
    ahos:status ahos:Open ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:Q3PARAFrameworkVsFolderTool a ahos:OpenQuestion ;
    rdfs:label "Q3 PARA as framework vs folder tool" ;
    rdfs:comment "Brainstorm Q3: is PARA a tag/property attached to entities (Project/Area/Resource/Archive as a classification axis) or a folder hierarchy that physically organises things? The brainstorm hypothesised that folder-PARA carries overhead while tag-PARA is lightweight. B currently has ahos:PARA as a KnowledgeFramework individual; the question is which interpretation that role plays. Resolution likely informs how PARAMPS (the expanded variant) gets implemented in substrate." ;
    ahos:about ahos:PARA ;
    ahos:status ahos:Open ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

# --- Open question from branch K (source-quality shape) ---
# Q-numbering continues from branch L's Q1/Q2/Q3 for ontology-key density;
# attribution is to branch K of version A (the brainstorm's source-quality cluster).

ahos:Q4SourceQualityShape a ahos:OpenQuestion ;
    rdfs:label "Q4 source quality — one dim or several" ;
    rdfs:comment "Brainstorm question (branch K of version A, q-source-quality-shape): is source quality a single classification axis, or is it composed of several (the brainstorm hypothesised formality + trustworthiness as candidate sub-axes)? Resolution shapes the SourceQuality class: keep flat with one set of values, or split into sub-classes / sub-properties. Also entangled with whether SourceQuality overlaps with sourceChannel and contentSubtype — closing this likely involves drawing the boundary explicitly. Pointed at ahos:SourceQuality because that's the structural decision the answer changes." ;
    ahos:about ahos:SourceQuality ;
    ahos:status ahos:Open ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

# --- Open questions folded in from branches D-I of version A ---
# Q-numbering continues consecutively from Q4. Each question carries
# ahos:about pointing at the class or individual whose shape it would change.

ahos:Q5TopicDetectionSignal a ahos:OpenQuestion ;
    rdfs:label "Q5 topic-boundary detection signal" ;
    rdfs:comment "Brainstorm question (branch D of version A, q-topic-detect): what signal does /capture bare mode actually use to detect a topic boundary? Candidates: an explicit user marker (\"---\" or similar), a long pause heuristic, LLM-inferred topic shift, the 30-message safety cap. Atomic-capture relies on this being reliable — one bare /capture call should produce one atom, not a blob. Pointed at ahos:TopicBoundary because that's the class whose detection contract the answer defines." ;
    ahos:about ahos:TopicBoundary ;
    ahos:status ahos:Open ;
    ahos:level "ontology" ; ahos:inBox "ABox" .

ahos:Q6OtherSurfaces a ahos:OpenQuestion ;
    rdfs:label "Q6 /capture on other surfaces (web / mobile / WhatsApp / email)" ;
    rdfs:comment "Brainstorm question (branch D of version A, q-other-surfaces): /capture exists on Claude Code today. What about web / mobile / WhatsApp / email? Each surface has different segmentation and routing affordances; the question is whether they reuse one /capture contract or each gets its own ingestion path. Resolution shapes the Surface taxonomy and how captureSkill binds to it. Pointed at ahos:captureSkill because that's the capability whose reach the answer defines." ;
    ahos:about ahos:captureSkill ;
    ahos:status ahos:Open ;
    ahos:level "ontology" ; ahos:inBox "ABox" .

ahos:Q7PointerModelling a ahos:OpenQuestion ;
    rdfs:label "Q7 pointer modelling — lifecycle stage or companion table" ;
    rdfs:comment "Brainstorm question (branch E of version A, q-pointer-modelling): is a registry-mode artifact (URL + metadata, no bytes) modelled as a regular Artifact at lifecycle_stage=Discovered, or as a separate companion table? Today the design assumes the lifecycle-stage path (one artifacts row carries both pointer and enriched states across its lifetime); a companion table would split them. Resolution affects the ah:Pointer class — keep as a sub-class of ahos:Artifact with a lifecycle marker, or split into a sibling class with its own substrate row. Pointed at ahos:Pointer because that's the class whose substrate shape the answer chooses." ;
    ahos:about ahos:Pointer ;
    ahos:status ahos:Open ;
    ahos:level "ontology" ; ahos:inBox "ABox" .

ahos:Q8PhysicalKnowledge a ahos:OpenQuestion ;
    rdfs:label "Q8 physical-world knowledge (no connector)" ;
    rdfs:comment "Brainstorm question (branch E of version A, q-physical-knowledge): how does ahOS capture knowledge that has no digital connector — handwritten notes, in-person conversations, physical mail, items on a desk, a book on a shelf? The discover loop assumes a ReadAdapter to fetch bytes; physical-world artifacts have no machine-readable source. Resolution likely lives at the capture-side rather than discover-side: a manual ingestion path that creates the Artifact + Pointer pair directly. Pointed at ahos:discoverTool because the question is essentially \"what's the discover-side answer for non-digital sources\"." ;
    ahos:about ahos:discoverTool ;
    ahos:status ahos:Open ;
    ahos:level "ontology" ; ahos:inBox "ABox" .

ahos:Q9TagTypoSilentFail a ahos:OpenQuestion ;
    rdfs:label "Q9 tag-namespace typo fails silently" ;
    rdfs:comment "Brainstorm question (branch G of version A, q-tag-typo): if a tag in capture_preferences carries a typo (e.g. \"appel\" instead of \"apple\"), the routing rule never matches and the silent failure mode is that the artifact lands somewhere unintended without any error. Open: do we ship typo-tolerance (Levenshtein / fuzzy match), a controlled vocab (predeclared tag list, reject unknown), a fail-loud check (warn at /capture if no rule matches), or accept the failure mode? Aligns conceptually with ahos:FailLoud but applies to a user-data layer rather than a binding layer. Pointed at ahos:capturePreferencesTable because that's the substrate the tags live in." ;
    ahos:about ahos:capturePreferencesTable ;
    ahos:status ahos:Open ;
    ahos:level "ontology" ; ahos:inBox "ABox" .

ahos:Q10SkillVsAgent a ahos:OpenQuestion ;
    rdfs:label "Q10 skill vs agent — distinct kinds or one subsumes the other" ;
    rdfs:comment "Brainstorm question (branch H of version A, q-skill-vs-agent): the design has ahos:Skill and ahos:AgentCapability as sibling sub-classes of ahos:Capability. Are they genuinely distinct (a skill is invocable-by-LLM scaffolding, an agent is an autonomous loop with its own goal), or does one subsume the other once the boundary is properly drawn? Resolution either justifies the two-class shape or collapses one into the other (and reshapes capability hosting per ADR-019). Pointed at ahos:Skill because that's the one of the pair whose definition the answer most likely re-tightens." ;
    ahos:about ahos:Skill ;
    ahos:status ahos:Open ;
    ahos:level "ontology" ; ahos:inBox "ABox" .

# --- Open questions folded in from branch J of version A ---

ahos:Q11RolesVsStores a ahos:OpenQuestion ;
    rdfs:label "Q11 roles vs stores — mixing two layers" ;
    rdfs:comment "Brainstorm question (branch J of version A, q-roles-vs-stores): are we conflating an abstract role taxonomy (the six MemoryRoles — routing/map/log/state/structured/archive) with concrete stores (Supabase tables, Notion DBs, Drive folders) when a single substrate plays multiple roles? ahos:entitiesTable already plays both mapRole and structuredRole, which makes the question concrete: should that be ONE row in the playsRole relation (entitiesTable→{map, structured}) or TWO separate facts in two different layers (a substrate layer with one entry per table, a role layer with one entry per role, joined by playsRole)? Resolution either keeps the current many-to-many playsRole shape or splits into a layered design. Pointed at ahos:MemoryRole because that's the abstraction whose layering the answer redefines." ;
    ahos:about ahos:MemoryRole ;
    ahos:status ahos:Open ;
    ahos:level "ontology" ; ahos:inBox "ABox" .

ahos:Q12CapabilityAsRole a ahos:OpenQuestion ;
    rdfs:label "Q12 capability registry — missing 7th memory role" ;
    rdfs:comment "Brainstorm question (branch J of version A, q-role-capability): the six-role taxonomy (routing/map/log/state/structured/archive) was derived from how knowledge stores divide labour. The ADR-019 hosting + binding layer (where capabilities — skills/agents/commands — are registered and resolved) is a similarly load-bearing substrate role but isn't in the taxonomy. Open: should there be a 7th memory role for capabilities (a \"capability registry\" or \"hosting\" role) carried by ahkmsRepo + the bindings table, or is capability hosting categorically different from memory roles and properly lives in its own taxonomy (ahos:Capability + ahos:Binding as it is today)? Pointed at ahos:MemoryRole because the answer either extends the enum or formally walls it off." ;
    ahos:about ahos:MemoryRole ;
    ahos:status ahos:Open ;
    ahos:level "ontology" ; ahos:inBox "ABox" .

# Tier 4 relationType tagging
ahos:tier         ahos:relationType ahos:Hierarchy .
ahos:duringPeriod ahos:relationType ahos:Relation .
ahos:decides      ahos:relationType ahos:Relation .
ahos:about        ahos:relationType ahos:Relation .
ahos:resolvedBy   ahos:relationType ahos:Relation .

################################################################################
# CHUNK 2 FOLD (2026-06-16)
#
# Brainstorm lines 22-118 — the four-lane audit of the current ingestion model.
# The 4-lane scaffold itself is explicitly rejected by the brainstorm's own
# caveat (lines 30-33); what's folded here is the *vocabulary* named within
# each lane, plus a handful of principles, gaps, and the entity-graph schema.
#
# 5 blocks: (1) cross-store lineage schema, (2) PARAMPS entity-graph schema
# (design-only at dev), (3) capture-side vocabulary, (4) vision-relevant
# principles, (5) enduring architectural gaps as KnownLimitations.
################################################################################

# --- Block 1: Cross-store lineage schema (artifact_external_links typed) ---

ahos:ArtifactExternalLink a owl:Class ;
    rdfs:subClassOf ahos:Entity ;
    rdfs:label "Artifact External Link" ;
    rdfs:comment "A cross-store lineage record — an (artifact_id, provider, kind, external_id) tuple that connects an ahkms artifact to a corresponding object in an external system (Notion task, state doc, Gmail thread). The substrate of ahos:CrossStoreLineage; idempotent on the four-tuple. kind='consumed_by_state' is the synthesis marker (ADR-013 §7); kind='task' / 'state_doc' express other cross-store relations. Realised by the artifact_external_links Supabase table (ahos:artifactExternalLinksTable). The brainstorm calls this 'the system's actual data model' (line 132)." ;
    ahos:level "ontology" ;
    ahos:inBox "TBox" .

ahos:provider a owl:DatatypeProperty ;
    rdfs:domain ahos:ArtifactExternalLink ;
    rdfs:range  xsd:string ;
    rdfs:label "provider" ;
    rdfs:comment "External system hosting the linked object. e.g. 'notion', 'gmail', 'drive'. One field of the (provider, kind, external_id) lineage tuple." ;
    ahos:level "ontology" ;
    ahos:inBox "TBox" .

ahos:externalId a owl:DatatypeProperty ;
    rdfs:domain ahos:ArtifactExternalLink ;
    rdfs:range  xsd:string ;
    rdfs:label "external id" ;
    rdfs:comment "Identifier of the linked object inside the provider's namespace. e.g. a Notion page ID, a Gmail message ID. The third field of the lineage tuple." ;
    ahos:level "ontology" ;
    ahos:inBox "TBox" .

ahos:linkKind a owl:DatatypeProperty ;
    rdfs:domain ahos:ArtifactExternalLink ;
    rdfs:range  xsd:string ;
    rdfs:label "link kind" ;
    rdfs:comment "Semantic role of this cross-store link. Examples: 'task' (links to a Notion task), 'state_doc' (links to a state-doc update), 'consumed_by_state' (synthesis consumption marker per ADR-013 §7). Open vocabulary — migration 049 dropped the rigid relationship_type CHECK constraint, so new kinds can be added without migration." ;
    ahos:level "ontology" ;
    ahos:inBox "TBox" .

ahos:ConsumedByState a ahos:Entity ;
    rdfs:label "consumed_by_state" ;
    rdfs:comment "The link kind value that marks an artifact as having been consumed by a state-doc synthesis pass. Written via create_external_link with (provider='notion', kind='consumed_by_state', external_id=state_doc_page_id) per ADR-013 §7 + ADR-018 §6. Implements ahos:PositiveFactStoreDeriveRest: presence of the link = consumed; absence = not-yet-consumed. Synthesisers filter via NOT EXISTS to surface unconsumed atoms." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:provider   ahos:relationType ahos:Relation .
ahos:externalId ahos:relationType ahos:Relation .
ahos:linkKind   ahos:relationType ahos:Relation .

# --- Block 2: PARAMPS entity-graph schema (design-only at dev, see PR #27) ---

ahos:PARAMPS a ahos:KnowledgeFramework ;
    rdfs:label "PARAMPS" ;
    rdfs:comment "The ahkms-specific extension of PARA: Project / Area / Resource / Memory / People / Secure / Archive. PARAMPS is the CONCEPTUAL framework, not a 1:1 description of the runtime entity_type set: of the 9 current entities.entity_type values (project, area, resource, people, event, organization, signal, place, concept), only 4 trace to PARAMPS letters (project/area/resource/people); the other 5 (event, organization, signal, place, concept) are net-new external-vocabulary anchors (schema.org / SKOS, plus app-specific signal). PARAMPS's own Memory/Secure/Archive letters have NO runtime entity_type — they were retired from the CHECK by migration 067 (#172, zero rows). Extends ahos:PARA with three additional categories — Memory (long-term factual knowledge), People (contacts and relationships), and Secure (sensitive information). Substrate tables live on dev; the entity-graph tooling (upsertEntity, relateEntities, linkArtifactEntity) is on feat/knowledge-graph-mcp / PR #27 — design-only at dev." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:PARAMPSEntity a owl:Class ;
    rdfs:subClassOf ahos:Entity ;
    rdfs:label "PARAMPS Entity" ;
    rdfs:comment "A named node in the PARAMPS knowledge graph — a real-world noun (Project / Area / Resource / Memory / People / Secure / Archive) tracked in the entities table. Carries a type from the PARAMPS vocabulary and a name; linked to other nodes via ahos:EntityRelationship edges and to artifacts via the linkArtifactEntity tool. Distinct from ahos:Artifact (captured content) and ahos:ArtifactExternalLink (cross-store pointer). Design-only at dev — see PR #27." ;
    ahos:level "ontology" ;
    ahos:inBox "TBox" .

ahos:EntityRelationship a owl:Class ;
    rdfs:subClassOf ahos:Entity ;
    rdfs:label "Entity Relationship" ;
    rdfs:comment "An open-vocabulary edge in the PARAMPS knowledge graph — a (source_entity, predicate, target_entity) triple stored in the entity_relationships table. Migration 049 dropped the rigid relationship_type CHECK constraint, making predicate an open string. Realises the 'relate entity→entity' step in the Lane 3 pipeline. Design-only at dev — see PR #27." ;
    ahos:level "ontology" ;
    ahos:inBox "TBox" .

ahos:relationshipPredicate a owl:DatatypeProperty ;
    rdfs:domain ahos:EntityRelationship ;
    rdfs:range  xsd:string ;
    rdfs:label "relationship predicate" ;
    rdfs:comment "The open-vocabulary verb on an entity-to-entity edge. e.g. 'mentions', 'owns', 'participates_in'. No controlled vocabulary enforced — open string per migration 049." ;
    ahos:level "ontology" ;
    ahos:inBox "TBox" .

ahos:ArtifactEntityLinkType a owl:Class ;
    rdfs:subClassOf ahos:Entity ;
    rdfs:label "Artifact-Entity Link Type" ;
    rdfs:comment "The strength / role of the association between an Artifact and a PARAMPSEntity when the entity is extracted from the artifact at synthesis time. Three values: ahos:PrimaryLink, ahos:MentionedLink, ahos:RelatedLink. Used by the linkArtifactEntity knowledge-graph tool — design-only at dev, see PR #27." ;
    ahos:level "ontology" ;
    ahos:inBox "TBox" .

ahos:PrimaryLink a ahos:ArtifactEntityLinkType ;
    rdfs:label "primary" ;
    rdfs:comment "The artifact is primarily about this entity." ;
    ahos:level "instance" ; ahos:inBox "ABox" .

ahos:MentionedLink a ahos:ArtifactEntityLinkType ;
    rdfs:label "mentioned" ;
    rdfs:comment "The entity appears in passing in the artifact." ;
    ahos:level "instance" ; ahos:inBox "ABox" .

ahos:RelatedLink a ahos:ArtifactEntityLinkType ;
    rdfs:label "related" ;
    rdfs:comment "The entity is contextually relevant to the artifact but not explicitly named." ;
    ahos:level "instance" ; ahos:inBox "ABox" .

ahos:relationshipPredicate ahos:relationType ahos:Relation .

# --- Block 3: Capture-side vocabulary (TagRule, DiscoveredPath, etc.) ---

ahos:TagRule a owl:Class ;
    rdfs:subClassOf ahos:Entity ;
    rdfs:label "Tag Rule" ;
    rdfs:comment "A user-defined routing rule stored in capture_preferences: a regex pattern matched against incoming artifact content or metadata to assign a tag and route the artifact to the appropriate target. The editable-opinion layer of the dumb-capture path — the user writes the rule, the /capture skill applies it. One of the key expressions of ahos:BuildOpinionsRentMechanics at the capture layer." ;
    ahos:level "ontology" ;
    ahos:inBox "TBox" .

ahos:DiscoveredPath a ahos:CapturePath ;
    rdfs:label "Discovered (system-initiated)" ;
    rdfs:comment "The source_channel value family 'discovered_<connector>' — artifacts written by the discover loop rather than by direct user action. The <connector> suffix names the ExternalSystem that originated the pointer (e.g. discovered_google_drive). All discovered artifacts start at ahos:lifecycleStage ahos:Discovered. The specific connector is carried by ahos:connectorOf on the Pointer. Distinct from ahos:APIPath (programmatic user-initiated) and ahos:ChatCalledPath (explicit user invocation). Introduced by ahos:TwoCadence per ADR-016." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:connectorOf a owl:ObjectProperty ;
    rdfs:domain ahos:Pointer ;
    rdfs:range  ahos:ExternalSystem ;
    rdfs:label "connector of" ;
    rdfs:comment "Links a registry-mode Pointer to the ExternalSystem it was discovered from. The <connector> part of the source_channel value 'discovered_<connector>' resolves to this ExternalSystem. e.g. a Drive-discovered Pointer ahos:connectorOf ahos:googleDrive. Enables queries like 'all pointers discovered from Gmail' when that adapter is built. Absent on Atoms and other Artifacts that arrived via user-initiated paths." ;
    ahos:level "ontology" ;
    ahos:inBox "TBox" .

ahos:contentHash a owl:DatatypeProperty ;
    rdfs:domain ahos:Pointer ;
    rdfs:range  rdfs:Literal ;
    rdfs:label "content hash" ;
    rdfs:comment "A digest (SHA-256 or equivalent) of the bytes at the ExternalSystem source, stored on the Pointer in processing_metadata at discover time and refreshed by the enrich path. Used by the enrich scheduler to detect whether a pointer's source has changed since last fetch, enabling idempotent discover passes. Absent on chat-captured Atoms (no remote source to hash)." ;
    ahos:level "ontology" ;
    ahos:inBox "TBox" .

ahos:FailedStage a ahos:LifecycleStage ;
    rdfs:label "failed" ;
    rdfs:comment "The enrich path writes lifecycle_stage='failed' when a fetch or extraction attempt fails, alongside an error timestamp in processing_metadata. Distinct from ahos:Failed (a Status value): this names the pipeline-position on the row, not the outcome of an action. A failed Pointer is retryable — the discover scheduler can attempt enrich again on a later pass, up to a retry cap. Closes a sync gap between the four canonical LifecycleStage values and what the enrich code actually writes." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:connectorOf ahos:relationType ahos:Relation .
ahos:contentHash ahos:relationType ahos:Relation .

# --- Block 4: Vision-relevant principles ---

ahos:DumpAndAsk a ahos:Principle ;
    rdfs:label "Dump-and-ask" ;
    rdfs:comment "The user-facing operational pattern ahOS enables: dump everything in, ask questions later. Capture is separated from retrieval in time and intent — the user does not need to predict what they will want to know when they capture. Realises ahos:R1UniversalAccess (anything captured is findable) and ahos:R2NeverForget (nothing is dropped at capture). The user-interaction counterpart to ahos:SynthesisTimeInterpretation: interpretation is deferred to ask-time, not forced at dump-time. Previously buried in the ahos:StrongRetrieval comment; promoted here to a citable Principle." ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:AgentOwnsOrchestration a ahos:Principle ;
    rdfs:label "Agent owns orchestration (no workflows row)" ;
    rdfs:comment "The artifacts table carries no orchestration or pipeline-state column. There is no workflows row. Orchestration state (retries, step tracking, multi-step pipeline position) is the agent's responsibility — held in the calling skill's context, not in the substrate. Corollary of ahos:CaptureIsDumb: if capture is dumb, the substrate has nothing to orchestrate. Keeps the substrate simple, append-only, and free of half-processed rows." ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:StateDocAsProjection a ahos:Principle ;
    rdfs:label "State doc as projection (not primary record)" ;
    rdfs:comment "A State Doc (ahos:personalStateDoc, ahos:workStateDoc) is not a primary record — it is a synthesised projection produced by a Synthesiser from the artifact stream. It is mutable because it can always be regenerated from the append-only artifact substrate. The diff-style update pattern (dos-eod writes incremental diffs rather than full rewrites) follows from this: the projection does not need to carry full history because the atom stream does. Anchors why the Memory side is append-only while the State side is mutable — they serve different masters. ADR-013 §2 + ADR-018 §4-7." ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

ahos:SingleAtomicSubstrate a ahos:Principle ;
    rdfs:label "Single atomic substrate (one table, many consumers)" ;
    rdfs:comment "Every synthesis consumer — dos-eod, weekly-reflection, investor-brief, correspondence — reads from the same artifacts table (ahos:artifactsRegister). There is no per-consumer copy, cache, or projection of the atom stream. A new consumer is added by pointing a new Synthesiser at search_knowledge / get_artifact; no schema change is needed. Consumption markers (ahos:ConsumedByState) let each consumer track its own read horizon without owning the data. Applies ahos:SingleSourceOfTruth at the atom-substrate level; follows from ahos:KnowledgeGrounded (consumers read via MCP contract, not direct substrate access)." ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

# Wire DumpAndAsk to the requirements it realises
ahos:DumpAndAsk ahos:realises ahos:R1UniversalAccess .
ahos:DumpAndAsk ahos:realises ahos:R2NeverForget .

# --- Block 5: Enduring architectural gaps (KnownLimitations) ---

ahos:EmbeddingsNotBuiltLimitation a ahos:KnownLimitation ;
    rdfs:label "Limitation: embeddings designed only, not built" ;
    rdfs:comment "LIMITED: ahos:HybridRetrieval defines the design contract for FTS + vector-embedding retrieval. The FTS half is built (Postgres tsvector over artifacts, used by search_knowledge today). The embedding half — vector generation, pgvector storage, semantic similarity queries — is designed in docs/design/embeddings.md but not implemented. IMPACT: retrieval is lexical-only; semantic similarity queries (e.g. 'find things about project velocity even if that phrase isn't used') are unavailable. The knowledge-tier model (Bronze/Silver/Gold) and ahos:Q4SourceQualityShape both assume signals embeddings would naturally provide. ACCEPTED BECAUSE: FTS is sufficient for current volume; embeddings carry infra cost and complexity that isn't justified before the retrieve-synthesise lane is fully built. WHAT CLOSING WOULD LOOK LIKE: pgvector extension in Supabase, a background embedding job on the enrich path, update search_knowledge to accept a semantic mode." ;
    ahos:level "meta" ;
    ahos:inBox "ABox" .

ahos:NotionInboxProjectionLimitation a ahos:KnownLimitation ;
    rdfs:label "Limitation: Notion Inbox as projection deferred" ;
    rdfs:comment "LIMITED: a planned enhancement where ahOS maintains a live projection of the Notion Inbox as a read surface — treating the Notion Inbox database as a computed view over the artifacts register rather than an independent store. Would let the user work from the Notion UI while the substrate stays authoritative. ACCEPTED BECAUSE: deferred per ADR-018 (which retired dos-inbox in favour of /capture as the unified surface); the projection design has not been specified. WHAT CLOSING WOULD LOOK LIKE: a write-back capability that, after capture, upserts a row into the Notion Inbox DB via the Notion MCP; an optional binding in capture_preferences to enable/disable per scope. Note: Notion is write-only via MCP today (no server-side ReadAdapter), so the projection is one-way (ahkms → Notion), not bidirectional." ;
    ahos:level "meta" ;
    ahos:inBox "ABox" .

ahos:MCPBoundaryCILimitation a ahos:KnownLimitation ;
    rdfs:label "Limitation: ADR-017 MCP-only boundary not CI-enforced" ;
    rdfs:comment "LIMITED: ADR-017 (the deletable-edge / correspondence-via-MCP-only rule, ahos:DeletableEdgeRule) requires that correspondence skills read the knowledge core only through MCP tools (search_knowledge, get_artifact) and never directly. This boundary is stated in the ADR but has no CI check; a developer could bypass it without any automated failure. IMPACT: the deletability guarantee (delete the correspondence edge, the knowledge system still builds and runs) is asserted but not mechanically tested. ACCEPTED BECAUSE: adding the import-graph lint is non-trivial and the boundary is respected in current code. WHAT CLOSING WOULD LOOK LIKE: a CI step that asserts no import of ahkms substrate modules from dotclaude skill files; or a build-boundary test that exercises the skill with MCP stubs." ;
    ahos:level "meta" ;
    ahos:inBox "ABox" .

ahos:GraphQueryLimitation a ahos:KnownLimitation ;
    rdfs:label "Limitation: no graph-traversal queries (get_artifact is point-lookup only)" ;
    rdfs:comment "LIMITED: ahos:getArtifactTool fetches a single artifact by ID plus its direct entity links (artifact → entity_relationships). There is no graph-traversal query path — e.g. 'find all artifacts linked to entities related to Project X', or 'two-hop entity neighbours of this artifact'. The knowledge graph (ahos:knowledgeGraph) is therefore write-only beyond point-lookup today. IMPACT: synthesis consumers must fetch entity links one artifact at a time and build the graph in-memory if they need relational reasoning. Cross-entity clustering and graph-distance signals (useful for bundling quality) are unavailable at the MCP layer. ACCEPTED BECAUSE: the entity-graph write path (PR #27) is itself not on dev yet; graph queries are premature until the graph is populated. WHAT CLOSING WOULD LOOK LIKE: add graph-traversal variants to search_knowledge or a new graph_query MCP tool; expose entity-neighbour expansion on get_artifact." ;
    ahos:level "meta" ;
    ahos:inBox "ABox" .

ahos:TwoAxisQueryLimitation a ahos:KnownLimitation ;
    rdfs:label "Limitation: the two-axis query model + as-of queries are design targets, not realised in the runtime graph" ;
    rdfs:comment "LIMITED: the header's three 'crisp query patterns' (rdf:type → Category, ahos:hasDomain → Domain, and their conjunction) and temporal as-of queries describe a model the running system does not yet have. Entities are typed by a STRING entities.entity_type column, not rdf:type ahos:Projects; there is no stored domain axis on entity rows (work/personal is a synthesis-time inferred dim-workspace, not a stored edge — ahos:hasDomain exists only in this TTL's toy ABox); valid_from/valid_to are written but entity_neighbourhood ignores them and get_artifact is point-lookup (see ahos:GraphQueryLimitation). IMPACT: the front-matter reads as capability but is aspiration — consumers cannot query the graph along these axes today. ACCEPTED BECAUSE: this is exactly the runtime-metaclass-TBox work of #312, whose accepted design (ADR-036: ontology as DB rows + derived instance_of) closes it by construction; as-of queries are #315. WHAT CLOSING WOULD LOOK LIKE: implement ADR-036's graph_instance_of view + entity_neighbourhood virtual-edge flag (#312) and as-of filtering (#315)." ;
    ahos:level "meta" ;
    ahos:inBox "ABox" .

# End of chunk 2 fold.

################################################################################
# CHUNK 3 FOLD (2026-06-16)
#
# Brainstorm lines 120-145 — "Patterns I noticed while mapping (flagged for
# reaction, not synthesised)". 6 patterns surveyed: P1 (one substrate) was
# folded in chunk 2 as ahos:SingleAtomicSubstrate; P2 needs a cross-lane
# meta-principle; P3 needs thesis-to-substrate bridge triples (range of
# ahos:realises was expanded above to enable them); P4-P6 are novel
# observations / gaps.
################################################################################

# P2 — cross-lane deferred-inference meta-principle

ahos:DeferredInferenceEverywhere a ahos:Principle ;
    rdfs:label "Deferred inference everywhere (cross-lane)" ;
    rdfs:comment "The defer-to-read-time rule is not local to /capture — it holds across every lane. Capture path: no inference. Discover path: pointers only, no fetch. Enrich path: fetch + extract, no classification. Synthesis path: all inference, at read time. A cross-lane meta-principle that ahos:CaptureIsDumb and ahos:SynthesisTimeInterpretation each instantiate within their respective lanes. The structural property of the whole pipeline (brainstorm 2026-06-15, line 128)." ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

# P3 — thesis-to-substrate bridge: the cross-store lineage substrate is what
# makes the "track knowledge across multiple points" thesis structurally true.
ahos:CrossStoreLineage    ahos:realises ahos:UnifiedKnowledgeManagementSystem .
ahos:ArtifactExternalLink ahos:realises ahos:UnifiedKnowledgeManagementSystem .

# P4 — open question: should skills/capabilities be PARAMPS entity-graph nodes?

ahos:Q13SkillAsEntity a ahos:OpenQuestion ;
    rdfs:label "Q13 skill as PARAMPS entity — should capabilities be entity-graph nodes?" ;
    rdfs:comment "Brainstorm observation (2026-06-15, line 135): the code has ahos:PARAMPSEntity for Project / Area / Resource / Memory / People / Secure, but ahos:Skill (and ahos:AgentCapability) are modelled as ahos:Capability, a parallel hierarchy with no link to the entity graph. A skill would naturally be a PARAMPSEntity of some new type (Capability?), making it trackable in the entities table and linkable to artifacts via linkArtifactEntity. Open: (a) should Capability be added as an 8th PARAMPS type and Skill made a subClassOf PARAMPSEntity, or (b) should Skill remain in the Capability hierarchy and gain a separate entity-graph projection, or (c) are they categorically separate and the observation is moot? Adjacent to ahos:Q12CapabilityAsRole (7th memory role), but scoped to entity-graph membership rather than memory-role taxonomy." ;
    ahos:about ahos:Skill ;
    ahos:status ahos:Open ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

# P5 — unified-queryable-knowledge gap as KnownLimitation

ahos:UnifiedQueryableKnowledgeLimitation a ahos:KnownLimitation ;
    rdfs:label "Limitation: knowledge graph scope excludes capabilities, decisions, integrations, and people-state" ;
    rdfs:comment "LIMITED: the knowledge graph today spans ingested content artifacts and PARAMPS entity nodes. The thesis (ahos:UnifiedKnowledgeManagementSystem) and ahos:NeverForget both imply the graph should also span: (a) capabilities — skills/agents/commands tracked as knowledge per ahos:SkillsAsKnowledge; (b) decisions — ADRs modelled as ahos:Decision nodes but not connected to the search_knowledge retrieval surface; (c) integrations — external system configurations (bindings, adapters) not exposed as queryable nodes; (d) people-state — contacts/collaborators exist in the PARAMPS People type but are not linked to the knowledge retrieval path. Each dimension has schema nodes; none are unified into a single query path alongside artifacts. IMPACT: 'never forget anything including your skills' is not structurally reachable — a search_knowledge query returns artifacts but not decisions, capabilities, or integration configs. ACCEPTED BECAUSE: unification requires extending the retrieval MCP layer (search_knowledge) to join across entity types — a non-trivial query design problem. WHAT CLOSING WOULD LOOK LIKE: a graph-query path in search_knowledge that accepts a type filter (artifact | decision | capability | integration | person) and returns ranked results across all; or a unified indexing pass that imports ADR nodes, Capability nodes, and integration bindings into the artifact stream as typed knowledge atoms." ;
    ahos:level "meta" ;
    ahos:inBox "ABox" .

# P6 — multi-store autonomy gap as KnownLimitation

ahos:MultiStoreAutonomyLimitation a ahos:KnownLimitation ;
    rdfs:label "Limitation: Notion and Gmail lack server-side ReadAdapters (agent-driven only)" ;
    rdfs:comment "LIMITED: ahos:googleDriveReadAdapter is the only ahos:ReadAdapter instance built. Notion and Gmail are MCP-accessible for reads and writes during an agent session but have no server-side connector that runs outside a session — no ahos:notionReadAdapter, no ahos:gmailReadAdapter. IMPACT: the discover loop (ahos:TwoCadence) can only run autonomously against Drive today; Notion tasks, Gmail threads, and Calendar events are invisible to the discover scheduler. The 'track knowledge across multiple points' thesis (ahos:UnifiedKnowledgeManagementSystem) therefore holds only when an agent session is running. Cross-store lineage (ahos:CrossStoreLineage) exists as a principle but population of ahos:ArtifactExternalLink rows for Notion / Gmail depends on agent-driven passes, not autonomous ones. ACCEPTED BECAUSE: Notion and Gmail each require OAuth server-side credential flows that add infra complexity; MCP-mediated access is sufficient for current usage patterns. WHAT CLOSING WOULD LOOK LIKE: server-side ReadAdapter implementations for Notion and Gmail that authenticate via stored tokens, register discovered objects as Pointers, and route them into the enrich path without requiring an open agent session." ;
    ahos:level "meta" ;
    ahos:inBox "ABox" .

# End of chunk 3 fold.

