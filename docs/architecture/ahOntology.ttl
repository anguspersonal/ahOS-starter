# F — Open: the estate (population of discovered-but-not-enriched pointers)

ahos:TheEstate a ahos:DesignConcept ;
    rdfs:label "The estate (the inventory of pointers)" ;
    rdfs:comment "Design-ontology branch E (2026-06-15, line 188): 'the estate' is the conceptual layer above ahos:Pointer — the *population* of registry-mode artifacts that ahos:discoverTool has surfaced but ahos:cap-enrich has not yet processed. Frames the cap-discover vs cap-enrich split as a flow between two states of the same artifact set: discovered-into-the-estate (lifecycle_stage='discovered') vs enriched-out-of-the-estate (lifecycle_stage='extracted' or beyond). The estate is *what I have* in registry form; the enriched body is *what I've filed*. Implements ahos:CentraliseMapDisperseContent: the estate is the centralised map, the bytes stay native. Distinct from ahos:KnowledgeRegistry (which is the substrate table); the estate is the conceptual population that the registry tracks." ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

# H — Open: skill vs agent — distinct or subsume?

ahos:Q20SkillVsAgentDistinction a ahos:OpenQuestion ;
    rdfs:label "Q20 skill vs agent — distinct capability kinds or one subsumes the other?" ;
    rdfs:comment "Design-ontology branch H (2026-06-15, line 269): the Capability class enumerates skill / agent / command / prompt as kinds, with ahos:Skill, ahos:AgentCapability, and ahos:Command modelled as distinct subclasses. Open whether the skill/agent split is load-bearing or whether agent is just 'a skill that is autonomously invoked rather than user-invoked' — i.e. whether the distinction is in the *capability* or in the *invocation pattern*. Resolution decides: (a) whether ahos:Skill and ahos:AgentCapability should merge into one Capability subclass with an InvocationPattern dimension, or (b) whether they stay separate because their authoring conventions / surface contracts diverge enough to warrant the split. Pointed at ahos:Capability because that's the parent class whose subclass hierarchy the answer reshapes." ;
    ahos:about ahos:Capability ;
    ahos:status ahos:Open ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

# K — Open: does source quality drive preservation level?

ahos:Q21SourceQualityDrivesPreservation a ahos:OpenQuestion ;
    rdfs:label "Q21 does source quality drive preservation level (file vs archive)?" ;
    rdfs:comment "Design-ontology Phase 2 incidental note 7 (2026-06-15, line 717): the brainstorm worked-examples suggest a rule — high-formality sources (e.g. council letter) get filed-for-retention (ahos:Filed); low-formality sources (e.g. handwritten-note photo) get archived (ahos:ColdStorage). If the rule holds, branch K (source-quality) and the preservation-level taxonomy collapse via a single mapping: SourceQuality → PreservationLevel becomes a function rather than two independent dimensions. Open whether (a) the mapping is deterministic (formality alone determines preservation), (b) probabilistic with override (formality is the default but the user/synthesiser can override per-artifact), or (c) the apparent correlation is coincidence and the two dimensions stay independent. Resolution unlocks Q4SourceQualityShape (committing to formality-as-axis) and informs how ahos:retentionTracker (future consumer) decides what to surface for review. Pointed at ahos:SourceQuality because that's where the cross-branch rule would live." ;
    ahos:about ahos:SourceQuality ;
    ahos:status ahos:Open ;
    ahos:level "ontology" ;
    ahos:inBox "ABox" .

# End of chunk 7 fold.


# ============================================================================
# APPENDIX A — SPECULATIVE BRANCHES (parked; NOT load-bearing) — #322, 2026-07-12
#
# Relocated here to keep the main body legible. The ontology red-team flagged
# these as speculative growth against vision.md's "not now": they have no runtime
# realisation today. Kept (not deleted) as design-reference — the mapping exercise
# had value. Do NOT treat as current capability. Semantically identical to their
# previous inline position (Turtle is order-independent); only location changed.
#
# Branches: Product (#77), Outcome (#78), KPI (#79), PreservationLevel (#82),
# AuditEvent (#76), and their properties (hasOutcome, produces, producesFor,
# measures, preservationLevel, auditHistory).
# ============================================================================

# --- Products, outcomes, KPIs (#77, #78, #79) ---

ahos:Product a owl:Class ;
    rdfs:subClassOf ahos:Entity ;
    rdfs:label "Product" ;
    rdfs:comment "Something ahOS creates and manages. Examples: a State Doc (current state per domain), the Knowledge Graph itself, the Knowledge Graph Visual rendering. Outputs of the system — distinct from the substrate components that produce them." ;
    ahos:level "ontology" ;
    ahos:inBox "TBox" .

ahos:Outcome a owl:Class ;
    rdfs:subClassOf ahos:Entity ;
    rdfs:label "Outcome" ;
    rdfs:comment "A desired end-state ahOS aims to deliver. Examples: well-ordered files, strong retrieval, self-managing task list. Outcomes anchor design decisions ('does this serve an outcome?') and are measured by KPIs." ;
    ahos:level "ontology" ;
    ahos:inBox "TBox" .

ahos:KPI a owl:Class ;
    rdfs:subClassOf ahos:Entity ;
    rdfs:label "Key Performance Indicator" ;
    rdfs:comment "A measurement that quantifies progress toward an Outcome. Each KPI links to one or more Outcomes via ahos:measures. Examples: captures per period, capture success rate, facts extracted per week. OPEN QUESTION (#79): where do the actual *measurement values* live — in the ontology, in an analytics DB, or both?" ;
    ahos:level "ontology" ;
    ahos:inBox "TBox" .

# --- Preservation policy (#82) ---

ahos:PreservationLevel a owl:Class ;
    rdfs:subClassOf ahos:Entity ;
    rdfs:label "Preservation Level" ;
    rdfs:comment "How an artifact is preserved long-term. Four levels (instances): Permanent, Filed, ColdStorage, Ephemeral. Applied to artifacts via ahos:preservationLevel. Names chosen to avoid clash with the PARA Archive category. OPEN QUESTION (#82): who/what decides — user, agent, or routing rules?" ;
    ahos:level "ontology" ;
    ahos:inBox "TBox" .

ahos:AuditEvent a owl:Class ;
    rdfs:subClassOf ahos:Entity ;
    rdfs:label "Audit Event" ;
    rdfs:comment "A single entry in an entity's audit history — who did what, when. Each event records the actor, the action verb, the timestamp, and optionally a before/after snippet. Multi-valued via ahos:auditHistory on the entity." ;
    ahos:level "ontology" ;
    ahos:inBox "TBox" .


ahos:hasOutcome a owl:ObjectProperty ;
    rdfs:domain ahos:Entity ;
    rdfs:range  ahos:Outcome ;
    rdfs:label "has outcome" ;
    rdfs:comment "Links a system or component to a desired outcome. e.g. ahos:ahOS ahos:hasOutcome ahos:WellOrderedFiles." ;
    ahos:level "ontology" ;
    ahos:inBox "TBox" .

ahos:produces a owl:ObjectProperty ;
    rdfs:domain ahos:Entity ;
    rdfs:range  ahos:Product ;
    rdfs:label "produces" ;
    rdfs:comment "Links a system or process to a product it creates and manages. e.g. ahos:ahOS ahos:produces ahos:personalStateDoc." ;
    ahos:level "ontology" ;
    ahos:inBox "TBox" .

ahos:producesFor a owl:ObjectProperty ;
    rdfs:domain ahos:Product ;
    rdfs:range  ahos:Domain ;
    rdfs:label "produces for" ;
    rdfs:comment "Links a product to the domain it's produced for. e.g. ahos:personalStateDoc ahos:producesFor ahos:personal. (One state doc per domain.)" ;
    ahos:level "ontology" ;
    ahos:inBox "TBox" .

ahos:measures a owl:ObjectProperty ;
    rdfs:domain ahos:KPI ;
    rdfs:range  ahos:Outcome ;
    rdfs:label "measures" ;
    rdfs:comment "Links a KPI to the Outcome it measures progress toward. e.g. ahos:CaptureSuccessRate ahos:measures ahos:WellOrderedFiles." ;
    ahos:level "ontology" ;
    ahos:inBox "TBox" .

ahos:preservationLevel a owl:ObjectProperty ;
    rdfs:domain ahos:Entity ;
    rdfs:range  ahos:PreservationLevel ;
    rdfs:label "preservation level" ;
    rdfs:comment "How an artifact is preserved long-term. e.g. an artifact ahos:preservationLevel ahos:Permanent." ;
    ahos:level "ontology" ;
    ahos:inBox "TBox" .

ahos:auditHistory a owl:ObjectProperty ;
    rdfs:domain ahos:Entity ;
    rdfs:range  ahos:AuditEvent ;
    rdfs:label "audit history" ;
    rdfs:comment "Multi-valued — an entity carries 0..n AuditEvent values in chronological order. RDF/OWL doesn't have built-in arrays; chronological ordering is encoded via schema:dateCreated on each AuditEvent. PROV-O alternative: prov:wasGeneratedBy chains; chose ahos: for simplicity." ;
    ahos:level "ontology" ;
    ahos:inBox "TBox" .

# --- Outcomes (#78) ---

ahos:WellOrderedFiles a ahos:Outcome ;
    rdfs:label "Well-ordered files" ;
    rdfs:comment "Files are filed where the user (or future agent) will find them, by the rules of the framework that organises their containing store." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:StrongRetrieval a ahos:Outcome ;
    rdfs:label "Strong retrieval" ;
    rdfs:comment "'Ask anything, get an answer.' The dump-and-ask thesis realised — including knowledge from external systems, not just what was explicitly captured." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:ContentCreationPipeline a ahos:Outcome ;
    rdfs:label "Functioning content creation pipeline" ;
    rdfs:comment "Drafts, posts, messages, replies created from grounded knowledge. Per ADR-017 (knowledge-grounded correspondence)." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:SelfManagingTaskList a ahos:Outcome ;
    rdfs:label "Self-managing task list" ;
    rdfs:comment "Tasks captured, derived, prioritised and surfaced without manual list maintenance." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:StructuredDataAutoUpdated a ahos:Outcome ;
    rdfs:label "Structured data updated automatically" ;
    rdfs:comment "The structured layer (entities + state docs) stays current as artifacts come in. No manual reconciliation." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:PeopleDatabase a ahos:Outcome ;
    rdfs:label "Well-functioning people database" ;
    rdfs:comment "People are entities with consistent attributes, history, and connection back to the artifacts that mention them." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

# Link ahOS to its outcomes
ahos:ahOS ahos:hasOutcome
    ahos:WellOrderedFiles, ahos:StrongRetrieval, ahos:ContentCreationPipeline,
    ahos:SelfManagingTaskList, ahos:StructuredDataAutoUpdated, ahos:PeopleDatabase .

# --- KPIs (#79) ---

ahos:CaptureCount a ahos:KPI ;
    rdfs:label "Capture count" ;
    rdfs:comment "Number of captures per period (day / week / month). Cadence: rolling weekly." ;
    ahos:measures ahos:WellOrderedFiles ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:CaptureSuccessRate a ahos:KPI ;
    rdfs:label "Capture success rate" ;
    rdfs:comment "% of captures that landed successfully (no errors, routed correctly). Cadence: rolling weekly." ;
    ahos:measures ahos:WellOrderedFiles ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:FactsExtractedWeekly a ahos:KPI ;
    rdfs:label "Facts extracted (weekly)" ;
    rdfs:comment "Number of facts (entity attributes, claims) extracted per week from captured artifacts." ;
    ahos:measures ahos:StructuredDataAutoUpdated ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:TasksExtractedWeekly a ahos:KPI ;
    rdfs:label "Tasks extracted (weekly)" ;
    rdfs:comment "Number of tasks derived from captures per week." ;
    ahos:measures ahos:SelfManagingTaskList ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:PushBackRate a ahos:KPI ;
    rdfs:label "Push-back rate" ;
    rdfs:comment "% of agent-inferred outputs the user pushed back on (rejected, corrected, deferred). A proxy for system accuracy." ;
    ahos:measures ahos:StrongRetrieval, ahos:StructuredDataAutoUpdated ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

# --- Products ahOS creates and manages (#77) ---

ahos:personalStateDoc a ahos:Product ;
    rdfs:label "Personal State Doc" ;
    rdfs:comment "Current state of things in the personal domain. Human-readable in <5 minutes." ;
    ahos:producesFor ahos:personal ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:workStateDoc a ahos:Product ;
    rdfs:label "Work State Doc" ;
    rdfs:comment "Current state of things in the work domain. Human-readable in <5 minutes. (This is the dos-eod-produced doc per ADR-018.)" ;
    ahos:producesFor ahos:work ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:knowledgeGraphProduct a ahos:Product ;
    rdfs:label "Knowledge Graph (as product)" ;
    rdfs:comment "The knowledge graph itself, surfaced as a product the system maintains. Realised by the ahos:knowledgeGraph instance (the data substrate)." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:knowledgeGraphVisual a ahos:Product ;
    rdfs:label "Knowledge Graph visual" ;
    rdfs:comment "Rendered, interactive view of the knowledge graph. Realised today by ahOntology.html and future runtime-graph renderings." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

# Link ahOS to its products
ahos:ahOS ahos:produces
    ahos:personalStateDoc, ahos:workStateDoc,
    ahos:knowledgeGraphProduct, ahos:knowledgeGraphVisual .

# --- Preservation levels (#82) — names chosen to avoid clash with PARA Archive ---

ahos:Permanent a ahos:PreservationLevel ;
    rdfs:label "Permanent" ;
    rdfs:comment "Indexed, surfaceable, retained indefinitely. Default for high-value content (meeting transcripts, decisions, formal docs)." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:Filed a ahos:PreservationLevel ;
    rdfs:label "Filed for retention" ;
    rdfs:comment "Kept at a specific path; reachable but not surfaced in default retrieval. e.g. council/correspondence." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:ColdStorage a ahos:PreservationLevel ;
    rdfs:label "Cold storage" ;
    rdfs:comment "Archived; rarely accessed. e.g. a handwritten-note photo after its derived tasks are filed." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .

ahos:Ephemeral a ahos:PreservationLevel ;
    rdfs:label "Ephemeral" ;
    rdfs:comment "Deleted after derivation. e.g. a casual chat capture once the task is extracted." ;
    ahos:level "instance" ;
    ahos:inBox "ABox" .
