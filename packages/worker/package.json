{
  "name": "@ahkms/worker",
  "version": "1.0.0",
  "description": "A minimal Node.js web application.",
  "main": "app.js",
  "author": "alphasec",
  "license": "MIT",
  "dependencies": {
    "@ahkms/core": "*",
    "@ahkms/shared": "*",
    "@anthropic-ai/sdk": "^0.71.2",
    "@sentry/node": "^10.36.0",
    "@supabase/supabase-js": "^2.89.0",
    "@types/cors": "^2.8.19",
    "@types/multer": "^2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "multer": "^2.0.2",
    "openai": "^4.0.0",
    "pg": "^8.16.3",
    "resend": "^6.8.0",
    "sharp": "^0.34.5"
  },
  "scripts": {
    "dev": "nodemon --ext js,ts --exec \"node -r ts-node/register app.js\"",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=__tests__/unit",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "lint": "echo 'No linting configured'",
    "export:golden": "node scripts/export-golden-extractions.js",
    "check:migration-drift": "node scripts/check-migration-drift.js",
    "check:migration-signatures": "node scripts/check-migration-signatures.js",
    "check:migration-versions": "node scripts/check-migration-versions.js",
    "check:migration-comments": "node scripts/check-migration-comments.js"
  },
  "keywords": [],
  "type": "commonjs",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.0.3",
    "@types/supertest": "^6.0.3",
    "fast-check": "^4.5.3",
    "jest": "~29.7.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
