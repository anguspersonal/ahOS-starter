# Worker service config.
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, ANTHROPIC_API_KEY, OPENAI_API_KEY,
# NOTION_PERSONAL_ACCESS_TOKEN, NOTION_WORK_ACCESS_TOKEN are promoted to the
# repo-root .env.example (shared across worker + mcp-server on Railway).

# Optional: if only web's env is loaded, worker falls back to these (same value as
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY above).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Direct Postgres connection string. Only used by scripts/check-migration-drift.js
# (CI migration-drift check), not read by the running service.
SUPABASE_DB_URL=

# --- HTTP server ---
PORT=3001
HOST=0.0.0.0
NODE_ENV=
CORS_ORIGIN=
# Default team id used when creating an artifact without an explicit team.
DEFAULT_TEAM_ID=

# --- Auth secrets ---
# Shared secret for the worker's own API auth middleware (WORKER_API_KEY preferred,
# API_KEY kept as a fallback for older configs).
WORKER_API_KEY=
API_KEY=
# HMAC secret for verifying inbound workflow-created webhooks.
WEBHOOK_SECRET=
# Shared secret for the PDF conversion webhook (PDF_HANDLER_SECRET preferred,
# CONVERTER_SHARED_SECRET kept as a fallback for older configs).
PDF_HANDLER_SECRET=
CONVERTER_SHARED_SECRET=

# --- Sentry monitoring ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=1.0
ENABLE_SENTRY_LOGGER=false

# Logging
LOG_LEVEL=info

# --- Alerts (Resend) ---
ALERT_EMAIL=
RESEND_API_KEY=
SENTRY_ALERT_EMAIL=

# --- Dedup sweep cadence ---
KMS_DEDUP_SWEEP_ENABLED=
KMS_DEDUP_SWEEP_INTERVAL_MINUTES=

# --- Exception-only alert evaluator cadence (#573) ---
# Deploy-level switch: unset or anything other than "true" leaves the cadence off.
# Per-user enable/disable and thresholds live in the DB
# (user_preferences.notification_preferences.exception_alerts, ADR-030) and are
# editable without a deploy. Needs RESEND_API_KEY + ALERT_EMAIL above to deliver.
KMS_ALERT_EVALUATOR_ENABLED=
# Minutes between evaluations. Default 1440 (daily).
KMS_ALERT_EVALUATOR_INTERVAL_MINUTES=
# Resend "From" header. Defaults to Resend's built-in onboarding@example.com,
# which needs no domain verification but can ONLY deliver to the address that
# owns the Resend account. Set this to a verified sending domain once one exists.
ALERT_FROM_EMAIL=

# Optional cap (characters) on derived-content length written by createDerived.
MAX_DERIVED_CONTENT_LENGTH=

# --- Core Engine Runner (ADR-101 §2 / #1409) ---
# Engine cadences and environment variables are read by packages/core/src/engine/main.ts.
