# Phase 0 MCP server config (see ADR-012 + docs/design/mcp-tool-layer.md)
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY,
# OPENAI_API_KEY, NOTION_PERSONAL_ACCESS_TOKEN, NOTION_WORK_ACCESS_TOKEN are
# promoted to the repo-root .env.example (shared across worker + mcp-server on Railway).
#
# TWO FILES ARE LOADED, AND THE ORDER IS LOAD-BEARING (#711).
# Every script in this package's package.json runs as:
#     node --env-file-if-exists=../../.env --env-file=.env ...
# so the repo-root .env loads FIRST and this file loads SECOND. Later files win,
# which means:
#   - a key set only at the root (e.g. SUPABASE_URL) is available here
#   - a key set in BOTH is taken from THIS file, so a package-local value
#     deliberately overrides the shared one
#   - a missing root .env is tolerated: node prints "not found. Continuing
#     without it." and carries on, which is why the root uses -if-exists
# Before this, scripts read only this file, so anything living at the root
# (Supabase credentials, in practice) was simply absent and the script died
# with "Missing required env var SUPABASE_URL".

# The single owner's user id (uuid from auth.users) — every artifact is owned by this user.
KMS_USER_ID=
# Storage bucket for note bodies (must exist). Defaults to "user-uploads"
# to match the rest of the app (worker hard-codes this; storage RLS policies cover it).
KMS_STORAGE_BUCKET=
# Primary Gemini model used by extract_text and L2 document summaries when GEMINI_API_KEY is set. Defaults to gemini-2.5-flash.
KMS_GEMINI_EXTRACT_MODEL=
# Fallback Anthropic model used by extract_text and L2 summaries when GEMINI_API_KEY is unset (or KMS_EXTRACT_PROVIDER=anthropic). Defaults to claude-opus-4-7.
KMS_EXTRACT_MODEL=
# Optional, defaults to text-embedding-3-small (1536 dims, ~$0.02/1M tokens).
KMS_EMBED_MODEL=
# Deprecated fallback for NOTION_WORK_ACCESS_TOKEN (on the root .env.example) — only used if that var is unset. Optional.
NOTION_API_KEY=

# --- Dex CRM tools (dex_list_tools / dex_call_tool) ---
# Required only for dex_call_tool; all other tools work without this.
# Requires a Dex Professional plan. Generate at https://getdex.com → Settings → API.
# Tokens never live in the database — this is the only place this key should appear.
DEX_API_KEY=

# --- Brevo tools (brevo_*) — ADR-055 ---
# Required only for the Brevo tools; all other tools work without this.
# Must be an MCP-ENABLED Brevo API key: Brevo → Account → SMTP & API → API Keys →
# "Generate a new API key" → toggle ON "Create MCP server API key". The key is shown
# once at creation. Tokens never live in the database — env only (ADR-045).
BREVO_MCP_API_KEY=
# Optional override for Brevo's hosted MCP endpoint (defaults to
# https://mcp.brevo.com/v1/brevo/mcp — the endpoint is early-access and may move).
BREVO_MCP_URL=

# --- Meta Ads tools (meta_ads_*) — #646 ---
# Required only for the Meta Ads tools; all other tools work without this. Without it,
# meta_ads_call_tool fails with a setup error naming this var; nothing else is affected.
# Must be a long-lived Meta SYSTEM USER access token scoped READ-ONLY (`ads_read`) —
# deliberately NOT `ads_management`: this integration reads campaign/insights data and
# never mutates a campaign (no pause/edit/create tool exists in this catalog at all).
# Mint one in Meta Business Settings → Users → System Users → Generate New Token,
# granting it the ad account(s) to read and the `ads_read` permission only. Tokens never
# live in the database — this is the only place this key should appear.
META_ADS_ACCESS_TOKEN=
# Optional override for the Marketing API version (defaults to v21.0). Meta sunsets
# versions roughly every two years; bump this rather than editing code when the pinned
# version approaches its sunset date (a version-related Graph API error is the signal).
META_ADS_API_VERSION=

# --- Slack post (slack_post) — #647 ---
# Required only for slack_post; all other tools work without this. Without it,
# slack_post fails with a setup error naming this var; nothing else is affected.
# Must be the Slack app's BOT token (xoxb-), scoped `chat:write`. Install the app
# to (or invite the bot into) every channel it should post to — Slack answers a
# post to a channel the bot isn't in with `not_in_channel`, not a bare 403.
#
# This is a DIFFERENT credential from SLACK_TOKEN_USER_OAUTH above: that one is
# the USER token slack_ingest reads to search the owner's own messages
# (search.messages is unavailable to bots). Posting as the bot and reading as
# the owner are disjoint jobs, and there is no fallback between the two tokens.
# SLACK_TOKEN_BOT_OAUTH pairs with SLACK_TOKEN_USER_OAUTH; the older name
# SLACK_BOT_TOKEN is still read as a fallback.
SLACK_TOKEN_BOT_OAUTH=

# --- RevenueCat metrics (revenuecat_get_metrics) — #647 ---
# Required only for revenuecat_get_metrics; all other tools work without this.
# Without it, the tool fails with a setup error naming this var; nothing else is
# affected. Must be a RevenueCat v2 (Production) SECRET API key. Read-only use:
# this client issues GETs against the project metrics endpoint only, there is no
# write path here. Mint one in RevenueCat → Project settings → API keys.
REVENUECAT_API_KEY=

# --- LinkedIn post (linkedin_post) (#1631 / #1632) ---
# Required only for linkedin_post; all other tools work without this. Without it,
# linkedin_post fails with a setup error naming this var; nothing else is affected.
# Must be a 60-day LinkedIn OAuth 2.0 member access token minted via the LinkedIn
# Developer Portal OAuth 2.0 Token Generator with scopes: openid, profile, w_member_social.
# Tokens never live in the database (env only, ADR-045).
LINKEDIN_ACCESS_TOKEN=

# --- Google Drive tools (drive_*) ---
# Required only for the Drive tools; capture/search/get/extract work without them.
# The project's OAuth client (Google Cloud Console -> APIs & Services -> Credentials)
# is a "Web application" client; enable the Google Drive API, ensure the OAuth consent
# screen Publishing status is set to "In production" (not "Testing", which revokes
# refresh tokens after 7 days with invalid_grant, #2052), then paste the client
# id/secret here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# One refresh token per Google ACCOUNT, not per service (#338): a single token covers
# Drive, Calendar and Gmail for whichever account consented. Mint each one once, after
# setting the two values above, signing in as the matching user on the consent screen:
#   npm --workspace @ahkms/mcp-server run google-auth -- --account personal
#   npm --workspace @ahkms/mcp-server run google-auth -- --account work
# The scope list is bundled deliberately (src/google/scopes.ts). A refresh token is
# scope-bound at mint time, so re-consenting for one extra scope REPLACES the token
# rather than extending it: adding a scope means re-minting EVERY account.
# Renamed from the unsuffixed GOOGLE_REFRESH_TOKEN so the two accounts are symmetric:
# neither is the implicit default. That asymmetry is what let a personal token sit in the
# work slot unnoticed (#1002). The old name is still read as a fallback, so an existing
# .env keeps working, but new setups should use this one.
GOOGLE_REFRESH_TOKEN_PERSONAL=
# Optional, and independent of the one above. Left unset, personal-account calls are
# unaffected and only account='work' calls fail, naming this var.
# NOTE (#857): setting this also ENROLS the Work account in the scheduled Drive
# discover sweep, which iterates whichever accounts are wired. That sweep still needs
# KMS_SCHEDULER_ENABLED=true, so nothing starts scanning from this var alone -- but on
# a server that already has the scheduler on, adding this token means a second nightly
# scan of a second Drive estate, writing pointers under source_channel
# 'discovered_gdrive_work'. Unset it again to stop the sweep.
GOOGLE_REFRESH_TOKEN_WORK=
# Loopback redirect used only by the google-auth helper. A Web application OAuth
# client requires this EXACT URI to be registered under "Authorized redirect URIs"
# in Google Cloud Console — a mismatch fails with redirect_uri_mismatch (#508). If
# you change the port, register the new URI too.
GOOGLE_OAUTH_REDIRECT=http://localhost:53682/oauth2callback

# --- GitHub tokens (#1010, #1366, ADR-101, #1926) ---
# GitHub fine-grained Personal Access Tokens are scoped to a single resource owner
# (`anguspersonal` vs `example-org`). ahOS splits GitHub credentials by resource owner,
# matching the Notion (`NOTION_PERSONAL_ACCESS_TOKEN` / `NOTION_WORK_ACCESS_TOKEN`)
# and Google (`GOOGLE_REFRESH_TOKEN_PERSONAL` / `GOOGLE_REFRESH_TOKEN_WORK`) pairs:
#
# 1. `GITHUB_PERSONAL_ACCESS_TOKEN`: used for personal (`anguspersonal/*`) GitHub
#    operations — reads, issue/comment/label writes, pull request writes, and
#    `ingest_github` (legacy per-surface aliases `GITHUB_TOKEN_INGEST`,
#    `GITHUB_TOKEN_ISSUES`, `GITHUB_ISSUES_TOKEN`, and `GITHUB_TOKEN_PULLS` are still
#    read as fallbacks).
# 2. `GITHUB_WORK_ACCESS_TOKEN`: used for all GitHub operations (reads,
#    issue/comment/label writes, pull request writes, and `ingest_github`) when
#    targeting `example-org/*` repositories.
#
# Neither token falls back to the other or to `GITHUB_TOKEN`.
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_WORK_ACCESS_TOKEN=
GITHUB_TOKEN_INGEST=

# --- Slack ingest (#1011) ---
# Optional. A Slack USER token (xoxp-), NOT a bot token, used READ ONLY by
# `slack_ingest` to pull messages you sent into the knowledge store. It must be a user
# token for two independent reasons: search.messages is unavailable to bots, and only a
# user token can see your DMs. Needs the `search:read` scope. Left unset, only
# slack_ingest fails, naming this var.
#
# Do NOT enable token rotation on the Slack app. Rotation expires the token every 12
# hours and requires a programmatic refresh that nothing here performs, so a nightly
# ingest would work once and then fail forever. Rotation is offered only once a
# redirect URL is set, and a single-workspace app installed with "Install to
# Workspace" needs no redirect URL, so leaving that field blank keeps it unavailable.
SLACK_TOKEN_USER_OAUTH=

# The same Slack app also issues a BOT token (xoxb-). As of #647, ahkms DOES read
# one — see SLACK_TOKEN_BOT_OAUTH below, for slack_post — but it is a separate variable
# from this one: slack_ingest's only call, search.messages, is unavailable to bot
# tokens entirely, and slack_post's chat.postMessage has no use for a user token,
# so posting and ingesting stay on their own credentials with no fallback between
# them. Adding scopes to the bot does not widen what the ingest sees.
# Optional. The address each account's token is EXPECTED to open. Not a credential
# and not required by the server: read only by `npm run google-check`, which reads
# the mailbox behind the token and fails on a mismatch. Set these and the wrong-token
# swap becomes a failed check instead of the wrong person's mail arriving under a
# correct-looking 200 (2026-09-05). Unset, the check still prints the address it found.
GOOGLE_ACCOUNT_EMAIL_PERSONAL=
GOOGLE_ACCOUNT_EMAIL_WORK=

# --- PostHog connections (ADR-060) ---
# One key per CONNECTION, named POSTHOG_API_KEY_<SLUG> where <slug> is the second half
# of the connection ref: `posthog:work` reads POSTHOG_API_KEY_WORK. Hyphens and
# dots in a slug become underscores (`posthog:brother-acting` reads
# POSTHOG_API_KEY_BROTHER_ACTING).
#
# Adding a connection is a variable here plus a user_integrations row. It is NOT a code
# change and NOT a deploy — that asymmetry is the point of ADR-060, and it is why these
# are resolved by convention rather than listed in credentials.ts.
#
# Mint at PostHog > personal settings > Personal API keys. Scope to `project:read` plus
# query read, and no more: the read-only boundary is enforced at the token here, which
# is something the Gmail scopes could not do.
#
# Region is per-connection and lives in the connection's config row, not here. A key
# minted in EU cloud 401s against the US host, which reads as a bad key rather than a
# wrong region — `scripts/posthog-smoke.ts` auto-detects and prints which one answered.
POSTHOG_API_KEY_WORK=
POSTHOG_API_KEY_PERSONAL=
#
# Writes travel on a SEPARATE key, POSTHOG_API_KEY_<SLUG>_WRITE, used only by
# posthog_write. Two keys rather than one wider key is the whole point: every read still
# goes out on a token that cannot mutate anything, so no bug in the write guards can
# turn a read into a write, and the read-only-by-construction property above survives
# the existence of a general write passthrough.
#
# Mint it with the narrowest scopes you actually intend to use (cohort:write, and only
# then). Leaving it unset is the safe default: reads keep working and every write fails
# as a named setup error rather than as a PostHog 403 about scopes.
#
# The connection must ALSO declare write_policy 'allowed' in its user_integrations
# config row. Two independent switches, because either one alone is a single point of
# failure for something that mutates shared analytics.
POSTHOG_API_KEY_WORK_WRITE=

# --- Work planning document (example-org/web-app#114) ---
# Bearer token for planning.example.com/planning, used by planning_read / planning_edit.
# Left unset, every other tool still works; the planning tools throw a setup error.
#
# Mint it into the Work Supabase project rather than inventing one here. The token is
# stored HASHED (SHA-256), so generate the pair and keep only the plaintext:
#   node -e "const c=require('crypto');const t='hlp_'+c.randomBytes(24).toString('base64url');console.log(t);console.log(c.createHash('sha256').update(t).digest('hex'))"
# then insert the hash into product_design.planning_api_tokens against a user row whose
# role decides what the token may do. Team tier reads, patches and saves; it cannot seal
# a screen or delete a snapshot. Revoke with `update ... set revoked_at = now()`, which
# takes effect on the next request with no deploy.
WORK_PLANNING_TOKEN=
# Which deployment the planning tools talk to. Defaults to https://planning.example.com.
# Point it at http://localhost:3001 to work against a local web-app checkout.
WORK_PLANNING_BASE_URL=

# --- Remote serving surface (HTTP + OAuth) — issue #84 / ADR-019 follow-up #1 ---
# Only needed by the HTTP entry point (`npm run start:http` / Railway). The stdio entry
# (`npm start`, Claude Desktop) ignores all of these. The Supabase service-role key above
# stays server-side; remote clients authenticate with an OAuth token, never that key.
#
# The server's own public HTTPS origin (no trailing slash). On Railway this is the service's
# generated domain, e.g. https://your-app.up.railway.app. Used as the OAuth issuer + resource id
# in discovery metadata, so it MUST be the exact externally-reachable URL.
MCP_PUBLIC_URL=
# The single-owner login gate: the password you type on the OAuth consent screen to authorize
# a new client. Pick a strong value; this is the credential that keeps the endpoint private.
MCP_OWNER_PASSWORD=
# HMAC secret for signing access/refresh JWTs. Generate with `openssl rand -hex 32`.
# Rotating it forces every client to re-authenticate.
MCP_OAUTH_JWT_SECRET=
# Optional token lifetimes in seconds. Defaults: access 2592000 (30d), refresh 2592000 (30d).
MCP_ACCESS_TOKEN_TTL=
MCP_REFRESH_TOKEN_TTL=
# Local-run HTTP port. Railway injects PORT automatically; only set this for local testing. Optional, defaults to 8080.
PORT=

# --- Action execution endpoint CORS (/api/actions/:id) ---
# Comma-separated list of exact allowed browser origins for POST /api/actions/:id (ADR-100).
# In production, this is the sole CORS source (exact string match only). In non-production,
# localhost/127.0.0.1 is also permitted.
WEB_ORIGIN=

# --- Scheduled Discover & Index cadences (ADR-016 Slice 3, #53) ---
# Only read by the HTTP entry point (`start:http` / Railway) — the stdio entry point
# never starts the scheduler. Explicit opt-in: unset (or anything other than "true")
# means the scheduler does nothing, so `npm run dev`/local testing never silently
# starts hitting production Drive/Supabase on a timer. Set to "true" in Railway prod only.
KMS_SCHEDULER_ENABLED=
# How often (minutes) the discover cadence runs. Optional, defaults to daily (1440).
KMS_DISCOVER_INTERVAL_MINUTES=
# How often (minutes) the enrich cadence runs (drains the 'discovered' backlog via
# enrich_next). Optional, defaults to daily (1440).
KMS_ENRICH_INTERVAL_MINUTES=
# Max pointers enriched per scheduled enrich run (passed as enrich_next's `limit`). Optional, defaults to 25.
KMS_ENRICH_BATCH_LIMIT=
# Gmail attachment discover connector (#1210): one pointer per attached file in the
# mailbox (spam, trash and drafts aside), for every wired Google account, run inside the
# discover cadence above (same lock, same interval). Explicit opt-in ON TOP of
# KMS_SCHEDULER_ENABLED (both must be "true"), because its first runs backfill a
# mailbox's whole attachment history. Read-only on Gmail.
KMS_GMAIL_ATTACHMENT_DISCOVER_ENABLED=
# Messages fetched per account per run. Each run sweeps mail since the last run first,
# then spends the rest on history, newest first. At the default and a daily discover
# interval, a mailbox with N attachment messages takes about N/1000 days to backfill
# (new mail is indexed from the second run regardless). Raise it for a faster first
# backfill, keeping a run well inside the 30-minute discover lock (one messages.get per
# message). Optional, defaults to 1000.
KMS_GMAIL_ATTACHMENT_DISCOVER_MAX_MESSAGES=

# --- Notion automations capability v0 (#546 / ADR-048) ---
# Inbound webhook surface (POST /webhooks/notion, HTTP entry point only) + daily
# reconciliation sweep for the completed_at_stamp rule. The rule's config (data
# source id, property names, done values) is NON-SECRET and lives in
# user_integrations notion_personal.automations — never here.
#
# SECRET — HMAC key for verifying inbound Notion webhook deliveries
# (X-Notion-Signature). This is the `verification_token` Notion sends when the
# subscription is created: leave it unset, create the subscription in the Notion
# integration UI, copy the token this server logs, complete the verification in
# the Notion UI, then set this var and redeploy. Until it is set, deliveries are
# acknowledged (200) but never processed.
NOTION_WEBHOOK_VERIFICATION_TOKEN=

# --- Inbound Webhook Surface (ADR-048) ---
# POST /webhooks/capture: Pre-shared secret token for direct inbound artifact capture
# via X-Capture-Secret or Authorization: Bearer <secret>.
CAPTURE_WEBHOOK_SECRET=

# Capture notes are capped at 256kb, `surface`/`captured_by` are pinned server-side, and
# dedup keys are namespaced `webhook:capture:`. Unset => 503 (fails closed).

# POST /webhooks/slack: Slack Events API signing secret for inbound message capture
# (verifies X-Slack-Signature HMAC, including on the url_verification challenge). Unset =>
# deliveries are acknowledged but never processed (only the unsigned challenge echo is
# answered, so the Request URL can be registered before the secret exists).
SLACK_SIGNING_SECRET=
# Optional allowlists (comma-separated Slack ids). Unset = ingest every workspace/channel/DM
# the app can see. When set, events from other teams or channels are acknowledged and dropped.
SLACK_ALLOWED_TEAM_IDS=
SLACK_ALLOWED_CHANNEL_IDS=

# POST /webhooks/drive: Verification token for Google Drive push notification watch channels
# (verifies X-Goog-Channel-Token, including on the sync handshake). Notifications are
# coalesced (single-flight + 10s debounce) into one discovery sweep. NOTE: nothing creates or
# renews the Drive changes.watch channel yet; until it is registered by hand (with this value
# as its token) this route is inert and the 15-minute polling cadence does the work.
DRIVE_WEBHOOK_TOKEN=

# All three /webhooks/* routes share a per-IP failed-auth limiter (10 failures / 15 min,
# then 429 + Retry-After; ADR-096 rule 4). Failed deliveries only: valid traffic is unmetered.
# Daily reconciliation sweep: explicit opt-in ON TOP of KMS_SCHEDULER_ENABLED
# (both must be "true") because this cadence WRITES to the personal Notion
# workspace. Interval defaults to 1440 minutes (daily).
KMS_NOTION_AUTOMATIONS_ENABLED=
KMS_NOTION_AUTOMATIONS_INTERVAL_MINUTES=
POSTHOG_API_KEY_WORK=
POSTHOG_API_KEY_PERSONAL=

GOOGLE_REFRESH_TOKEN_PERSONAl=
GOOGLE_REFRESH_TOKEN_WORK=