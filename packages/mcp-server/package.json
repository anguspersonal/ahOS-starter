{
  "name": "@ahkms/mcp-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "MCP tool layer over the knowledge store (capture, search, get, extract) plus full Google Drive interaction. See docs/design/mcp-tool-layer.md and ADR-012.",
  "main": "src/index.ts",
  "scripts": {
    "start": "node --env-file-if-exists=../../.env --env-file=.env ../../node_modules/tsx/dist/cli.mjs src/index.ts",
    "dev": "node --env-file-if-exists=../../.env --env-file=.env ../../node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "serve": "npm run start",
    "start:http": "node --env-file-if-exists=../../.env --env-file=.env ../../node_modules/tsx/dist/cli.mjs src/http.ts",
    "start:http:prod": "node dist/http.js",
    "dev:http": "node --env-file-if-exists=../../.env --env-file=.env ../../node_modules/tsx/dist/cli.mjs watch src/http.ts",
    "build": "tsc",
    "lint": "eslint --quiet .",
    "lint:warnings": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "clean": "rm -rf dist",
    "smoke": "node --env-file-if-exists=../../.env --env-file=.env ../../node_modules/tsx/dist/cli.mjs scripts/smoke.ts",
    "demo:actions": "node --env-file-if-exists=../../.env --env-file-if-exists=.env ../../node_modules/tsx/dist/cli.mjs scripts/demo-actions.ts",
    "smoke:http": "node ../../node_modules/tsx/dist/cli.mjs scripts/http-smoke.ts",
    "notion-page-smoke": "node --env-file-if-exists=../../.env --env-file=.env ../../node_modules/tsx/dist/cli.mjs scripts/notion-page-smoke.ts",
    "drive-smoke": "node --env-file-if-exists=../../.env --env-file=.env ../../node_modules/tsx/dist/cli.mjs scripts/drive-smoke.ts",
    "docs-smoke": "node --env-file-if-exists=../../.env --env-file=.env ../../node_modules/tsx/dist/cli.mjs scripts/docs-smoke.ts",
    "linkedin-smoke": "node --env-file-if-exists=../../.env --env-file=.env ../../node_modules/tsx/dist/cli.mjs scripts/linkedin-smoke.ts",
    "linkedin-whoami": "node --env-file-if-exists=../../.env --env-file=.env ../../node_modules/tsx/dist/cli.mjs scripts/linkedin-whoami.ts",
    "posthog-smoke": "node --env-file-if-exists=../../.env --env-file=.env ../../node_modules/tsx/dist/cli.mjs scripts/posthog-smoke.ts",
    "google-auth": "node --env-file-if-exists=../../.env --env-file=.env ../../node_modules/tsx/dist/cli.mjs scripts/google-oauth.ts",
    "microsoft-auth": "tsx scripts/microsoft-oauth.ts",
    "google-check": "node --env-file-if-exists=../../.env --env-file-if-exists=.env scripts/check-google-scopes.mjs",
    "backfill-embeddings": "node --env-file-if-exists=../../.env --env-file=.env ../../node_modules/tsx/dist/cli.mjs scripts/backfill-embeddings.ts",
    "check-vocab-diff": "node --env-file-if-exists=../../.env --env-file-if-exists=.env ../../node_modules/tsx/dist/cli.mjs scripts/check-vocab-diff.ts",
    "dos-coverage-parity": "node --env-file-if-exists=../../.env --env-file=.env ../../node_modules/tsx/dist/cli.mjs scripts/dos-coverage-parity.ts",
    "populate-source-url": "node --env-file-if-exists=../../.env --env-file=.env ../../node_modules/tsx/dist/cli.mjs scripts/populate-source-url.ts",
    "skill-sync": "node --env-file-if-exists=../../.env --env-file=.env ../../node_modules/tsx/dist/cli.mjs src/skill-sync/cli.ts",
    "whatsapp-link": "node --env-file-if-exists=../../.env --env-file-if-exists=.env ../../node_modules/tsx/dist/cli.mjs scripts/whatsapp-link.ts",
    "test": "npm run test:unit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@ahkms/core": "*",
    "@ahkms/shared": "*",
    "@anthropic-ai/sdk": "^0.71.2",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@sentry/node": "^10.70.0",
    "@sentry/profiling-node": "^10.70.0",
    "@supabase/supabase-js": "^2.89.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "google-auth-library": "^9.15.1",
    "googleapis": "^144.0.0",
    "jose": "^4.15.9",
    "openai": "^4.0.0",
    "qrcode-terminal": "^0.12.0",
    "yaml": "^2.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/n3": "^1.26.1",
    "@types/node": "^20.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "n3": "^1.26.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.8"
  }
}
